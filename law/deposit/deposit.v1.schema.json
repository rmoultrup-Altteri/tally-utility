{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tally-utility/law/deposit/deposit.v1.schema.json",
  "title": "Deposit rule, version 1",
  "description": "What a state's law says about customer security deposits for one customer class and one basis: the cap, the triggers for an additional deposit, which waivers reach it, whether and how the deposit earns interest, how it comes back, and any instalment schedule. Replaces the typed columns and child tables of the v5.4.2-15 draft. Every law kind also admits the document 'the law leaves this to the utility'. Out of version 1 on purpose, each refused rather than dropped: periodic recalculation of a deposit, instalments tied to bills, a sum cap or a cap add-on, guarantor caps, and municipal deposit funds (application/deposits-terms-v1-design-2026-10-12.md, section 4).",
  "oneOf": [
    {
      "$ref": "#/$defs/law"
    },
    {
      "$ref": "#/$defs/delegated"
    }
  ],
  "$defs": {
    "citation": {
      "type": "string",
      "pattern": "[A-Za-z0-9]"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "size"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "months",
            "bills"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "A span counted in calendar months or in bills."
    },
    "instrument": {
      "type": "string",
      "enum": [
        "cash",
        "letter_of_credit",
        "certificate_of_deposit",
        "surety_bond",
        "prepayment",
        "guarantor",
        "other_agreed"
      ]
    },
    "instruments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instrument"
      },
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true
    },
    "delegated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governs",
        "citation"
      ],
      "properties": {
        "governs": {
          "type": "string",
          "const": "delegated_to_utility"
        },
        "citation": {
          "type": "string",
          "pattern": "[A-Za-z0-9]"
        },
        "note": {
          "type": "string",
          "pattern": "[A-Za-z0-9]"
        }
      }
    },
    "cap_none": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "version"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "const": "none"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        }
      },
      "description": "The law sets no cap."
    },
    "cap_unruled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "version"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "const": "unruled"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        }
      },
      "description": "The law may set a cap, but it is not known. Not the same as none: unknown law is not permission."
    },
    "cap_parts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "version",
        "combinator",
        "scope",
        "parts"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "const": "parts"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "combinator": {
          "type": "string",
          "enum": [
            "single",
            "lesser_of",
            "greater_of"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "per_deposit",
            "combined"
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cap_part"
          },
          "minItems": 1,
          "maxItems": 4
        }
      },
      "description": "The cap is built from one or more parts. single: exactly one part. lesser_of / greater_of: two or more. per_deposit: each deposit within the cap; combined: the total held within it. That each kind appears at most once is the area's insert check."
    },
    "cap": {
      "oneOf": [
        {
          "$ref": "#/$defs/cap_none"
        },
        {
          "$ref": "#/$defs/cap_unruled"
        },
        {
          "$ref": "#/$defs/cap_parts"
        }
      ]
    },
    "cap_part": {
      "oneOf": [
        {
          "$ref": "#/$defs/part_fraction"
        },
        {
          "$ref": "#/$defs/part_months"
        },
        {
          "$ref": "#/$defs/part_fixed"
        },
        {
          "$ref": "#/$defs/part_highest"
        },
        {
          "$ref": "#/$defs/part_seasonal"
        }
      ]
    },
    "part_fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "divisor"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "fraction_of_annual_billing"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "divisor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Estimated annual billing divided by the divisor (Texas residential gas: 6)."
    },
    "part_months": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "months"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "months_of_billing"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "months": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "This many months of estimated billing."
    },
    "part_fixed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "amount"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "fixed_amount"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "A fixed amount."
    },
    "part_highest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "count",
        "window_months"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "highest_bills"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "window_months": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The total of the customer's highest N bills over the window (Arkansas: the 2 highest in 12 months)."
    },
    "part_seasonal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "multiple",
        "season"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "seasonal_average"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "multiple": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "season": {
          "$ref": "#/$defs/code"
        }
      },
      "description": "A multiple of the average monthly bill for a season (New York: twice the heating-season average)."
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/cond_count"
        },
        {
          "$ref": "#/$defs/cond_ratio"
        },
        {
          "$ref": "#/$defs/cond_all"
        },
        {
          "$ref": "#/$defs/cond_any"
        }
      ]
    },
    "cond_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "event",
        "at_least",
        "window",
        "consecutive",
        "exclude_disputed"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "count"
        },
        "event": {
          "$ref": "#/$defs/code"
        },
        "at_least": {
          "type": "integer",
          "minimum": 1
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "consecutive": {
          "type": "boolean"
        },
        "exclude_disputed": {
          "type": "boolean"
        }
      },
      "description": "At least N of an event in a window. consecutive: the N must be in a row. exclude_disputed: disputed bills do not count. A delinquency definition is an event in the vocabulary (for example past_due_over_30_days)."
    },
    "cond_ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "measure",
        "op",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "ratio"
        },
        "measure": {
          "type": "string",
          "enum": [
            "usage_to_estimate",
            "final_bill_to_class_average"
          ]
        },
        "op": {
          "type": "string",
          "enum": [
            "at_least",
            "greater_than"
          ]
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "A measured ratio compared with a value. The core supplies the measure."
    },
    "cond_all": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "of"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "all_of"
        },
        "of": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 2,
          "maxItems": 6
        }
      },
      "description": "Every one of the conditions holds."
    },
    "cond_any": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "of"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "any_of"
        },
        "of": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 2,
          "maxItems": 6
        }
      },
      "description": "At least one of the conditions holds."
    },
    "guard": {
      "oneOf": [
        {
          "$ref": "#/$defs/g_pay"
        },
        {
          "$ref": "#/$defs/g_age"
        },
        {
          "$ref": "#/$defs/g_move"
        },
        {
          "$ref": "#/$defs/g_assess"
        },
        {
          "$ref": "#/$defs/g_notice"
        },
        {
          "$ref": "#/$defs/g_cure"
        },
        {
          "$ref": "#/$defs/g_since"
        }
      ]
    },
    "g_pay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "days"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "payment_due_days"
        },
        "days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Days the customer has to pay once required (Texas usage deposit: 2)."
    },
    "g_age": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "months"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "not_after_service_months"
        },
        "months": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The trigger cannot be used after this many months of service (Arkansas usage trigger: 12)."
    },
    "g_move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "days"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "not_if_moved_within_days"
        },
        "days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "No re-assessment when service moves to a new location within this many days."
    },
    "g_assess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "days"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "assess_within_days"
        },
        "days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The deposit must be assessed within this many days of the event."
    },
    "g_notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "days"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "notice_days"
        },
        "days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Written notice this many days before assessment."
    },
    "g_cure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "cure_code"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "cured_by"
        },
        "cure_code": {
          "$ref": "#/$defs/code"
        }
      },
      "description": "A customer action entered before assessment cancels the trigger (a kept payment arrangement)."
    },
    "g_since": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "event",
        "years"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "not_after_cumulative_service_years_since"
        },
        "event": {
          "$ref": "#/$defs/code"
        },
        "years": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The trigger lapses after this many years of cumulative service since the event."
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "trigger_code",
        "condition",
        "guards"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "trigger_code": {
          "$ref": "#/$defs/code"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "guards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guard"
          },
          "maxItems": 6
        }
      },
      "description": "An additional-deposit trigger the law allows: when the condition holds (and no guard stops it), a deposit may be required."
    },
    "applies_any": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "any_trigger"
        }
      },
      "description": "Reaches a deposit under any trigger."
    },
    "applies_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trigger_code"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "trigger"
        },
        "trigger_code": {
          "$ref": "#/$defs/code"
        }
      },
      "description": "Reaches a deposit under this trigger only."
    },
    "applies_to": {
      "oneOf": [
        {
          "$ref": "#/$defs/applies_any"
        },
        {
          "$ref": "#/$defs/applies_trigger"
        }
      ]
    },
    "effect_excuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "excuse"
        }
      },
      "description": "The deposit is not required."
    },
    "effect_reduce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fraction"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "reduce"
        },
        "fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "description": "The deposit is reduced by this fraction."
    },
    "effect_defer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "days"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "defer"
        },
        "days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The deposit is deferred by this many days."
    },
    "effect": {
      "oneOf": [
        {
          "$ref": "#/$defs/effect_excuse"
        },
        {
          "$ref": "#/$defs/effect_reduce"
        },
        {
          "$ref": "#/$defs/effect_defer"
        }
      ]
    },
    "disq_none": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "none"
        }
      },
      "description": "The waiver has no disqualifier of its own."
    },
    "disq_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "condition"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "condition"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        }
      },
      "description": "The waiver is lost while this condition holds (New York: terminated for nonpayment in the past six months)."
    },
    "disqualified_by": {
      "oneOf": [
        {
          "$ref": "#/$defs/disq_none"
        },
        {
          "$ref": "#/$defs/disq_condition"
        }
      ]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "waiver_class",
        "applies_to",
        "effect",
        "also_releases_held",
        "disqualified_by"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "waiver_class": {
          "$ref": "#/$defs/code"
        },
        "applies_to": {
          "$ref": "#/$defs/applies_to"
        },
        "effect": {
          "$ref": "#/$defs/effect"
        },
        "also_releases_held": {
          "type": "boolean"
        },
        "disqualified_by": {
          "$ref": "#/$defs/disqualified_by"
        }
      },
      "description": "A waiver class that relieves a deposit under this rule. also_releases_held: a deposit already held is released too (New York: 'demand or hold')."
    },
    "interest_none": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "version"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "const": "none"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        }
      },
      "description": "Deposits under this rule earn no interest."
    },
    "rate_published": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "binding",
        "by_hold"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "published"
        },
        "name": {
          "$ref": "#/$defs/code"
        },
        "binding": {
          "type": "string",
          "enum": [
            "minimum",
            "reference"
          ]
        },
        "by_hold": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "up_to_months",
              "name"
            ],
            "properties": {
              "up_to_months": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "$ref": "#/$defs/code"
              }
            }
          },
          "maxItems": 4
        }
      },
      "description": "The rate is a named published value. by_hold: while the deposit has been held up to N months, use that named value instead. binding minimum: the utility's own rate may not go below it (decision 4); reference: it is only compared."
    },
    "rate_fixed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rate",
        "binding"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "fixed"
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "binding": {
          "type": "string",
          "enum": [
            "minimum",
            "reference"
          ]
        }
      },
      "description": "A rate the law states itself (Louisiana: 0.05)."
    },
    "rate_utility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "utility_sets"
        }
      },
      "description": "The law leaves the rate to the utility."
    },
    "rate": {
      "oneOf": [
        {
          "$ref": "#/$defs/rate_published"
        },
        {
          "$ref": "#/$defs/rate_fixed"
        },
        {
          "$ref": "#/$defs/rate_utility"
        }
      ]
    },
    "method_simple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "simple"
        }
      }
    },
    "method_compound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "period"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "compound"
        },
        "period": {
          "type": "string",
          "enum": [
            "monthly",
            "annual"
          ]
        }
      },
      "description": "Compounded at the end of each period (PG&E: monthly)."
    },
    "method": {
      "oneOf": [
        {
          "$ref": "#/$defs/method_simple"
        },
        {
          "$ref": "#/$defs/method_compound"
        }
      ]
    },
    "hold_none": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "none"
        }
      },
      "description": "Interest runs from the posting date, however long the deposit is held."
    },
