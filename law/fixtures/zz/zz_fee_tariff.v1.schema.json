{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tally-utility/law/fixtures/zz/zz_fee_tariff.v1.schema.json",
  "title": "ZZ connection fee, a utility's own tariff, version 1 (fixture)",
  "type": "object",
  "additionalProperties": false,
  "required": ["fee"],
  "properties": {
    "fee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "version", "id", "amount"],
      "properties": {
        "strategy": {"type": "string", "const": "flat"},
        "version": {"type": "integer", "minimum": 1, "maximum": 1},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "amount": {"type": "number", "minimum": 0}
      }
    },
    "note": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "[A-Za-z0-9]"}
  }
}
