+    v_tb     numeric := 0;
+    v_hold_k numeric;
+    v_hold_p numeric;
+    v_take   numeric;
+    v_short  numeric;
+    r        record;
+BEGIN
+    SELECT * INTO c FROM public.customer_credits k WHERE k.id = p_credit_id AND k.origin_type = 'overpayment';
+    IF NOT FOUND THEN
+        RETURN;
+    END IF;
+    SELECT p.amount INTO v_pay FROM public.payments p WHERE p.id = c.source_payment_id;
+    FOR r IN SELECT l.id, l.transaction_date, l.amount, l.created_at FROM public.account_ledger l
+              WHERE l.id = ANY (public.ledger_tree_ids(public.cash_arrival_entry('payment', c.source_payment_id)))
+              ORDER BY l.created_at, l.id LOOP
+        absorbed := 0;
+        IF r.created_at >= c.created_at AND r.amount > 0 THEN
+            v_hold_k := c.original_amount - v_abs - public.cash_drawn_at('credit', c.id, r.created_at);
+            v_hold_p := v_pay - c.original_amount - (v_tb - v_abs) - public.cash_drawn_at('payment', c.source_payment_id, r.created_at);
