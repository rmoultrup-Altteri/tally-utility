+     WHERE c.id = p_credit_id AND c.origin_type = 'overpayment'
+       AND c.issued_date <= p_on AND c.created_at <= p_recorded_at
+       AND (c.status <> 'voided' OR c.status_recorded_at > p_recorded_at);
+    IF NOT FOUND THEN
