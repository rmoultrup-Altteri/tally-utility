+
+-- r8 (Opus B1, Codex B2): what a credit holds of its own: its position
+-- without the cover, the shares as recorded. A position is an attribution
+-- (Ryan, 2026-11-01, option A): with the cover, a credit whose money covers a
+-- deficit beside it reads less than it holds. Every check that nothing is
+-- left on an escheated credit, and a reissue's size, read this: the cover
+-- lifts when the deficit goes, and the money would come back.
+CREATE OR REPLACE FUNCTION public.customer_credit_own_remaining_as_of(p_credit_id uuid, p_on date, p_recorded_at timestamp with time zone) RETURNS numeric
+    LANGUAGE plpgsql STABLE
+    SET search_path = public, pg_temp
+    AS $$
+DECLARE
+    v_root uuid;
+    v_left numeric;
+BEGIN
+    PERFORM public.cash_coordinates_required('customer_credit_own_remaining_as_of', p_on, p_recorded_at);
+    v_root := public.overpayment_root(p_credit_id);
+    IF v_root IS NULL THEN
+        SELECT x.remaining INTO v_left FROM public.customer_credit_position_as_of(p_credit_id, p_on, p_recorded_at) x;
+        RETURN v_left;
+    END IF;
+    SELECT c.original_amount - coalesce((SELECT s.absorbed FROM public.overpayment_absorbed_as_of(v_root, p_on, p_recorded_at, false) s
+                                          WHERE s.credit_id = c.id), 0)
+             - d.applied - d.refunded - d.given_up - d.carried INTO v_left
+      FROM public.customer_credits c
+      CROSS JOIN LATERAL public.customer_credit_draws_as_of(c.id, p_on, p_recorded_at) d
+     WHERE c.id = p_credit_id AND c.issued_date <= p_on AND c.created_at <= p_recorded_at;
+    RETURN v_left;
+END;
+$$;
