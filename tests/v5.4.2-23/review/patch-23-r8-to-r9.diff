 REVOKE ALL ON FUNCTION public.check_cash_order(text, uuid, timestamp with time zone, uuid, text) FROM PUBLIC;
 GRANT EXECUTE ON FUNCTION public.check_cash_order(text, uuid, timestamp with time zone, uuid, text) TO tally_app;
+
+-- r9 (Opus B1): the recorded-order rule for money leaving a family (a
+-- refund of the payment or of one of its credits cancelled or returned, a
+-- family credit voided). What leaves goes back to its source at the move's
+-- stamp, and overpayment_shares places each take-back under the payment by
+-- what each credit held at the take-back's instant: a move stamped before a
+-- take-back already recorded would move that take-back's share between the
+-- credits after the fact, onto or off one since escheated. So the move is
+-- not recorded before a row under the payment's posting entry: 40001 for a
+-- move stamped at its transaction's start (the retry lands after the row;
+-- the bank's return is still recorded, only its stamp moves), 23514 for a
+-- time chosen for it. Only for a payment with an overpayment family; the
+-- caller holds the payment's lock, which every row under the entry takes
+-- (enforce_ledger_reversal), so a committed one is seen here.
+CREATE OR REPLACE FUNCTION public.check_cash_leaving_order(p_payment_id uuid, p_at timestamp with time zone, p_what text)
+    RETURNS void
+    LANGUAGE plpgsql STABLE
+    SET search_path = public, pg_temp
+    AS $$
+DECLARE
+    v_entry    uuid;
+    v_later_id uuid;
+    v_later_at timestamptz;
+BEGIN
+    IF p_payment_id IS NULL OR NOT EXISTS (SELECT 1 FROM public.customer_credits c WHERE c.source_payment_id = p_payment_id AND c.status <> 'voided') THEN
+        RETURN;
+    END IF;
+    v_entry := public.cash_arrival_entry('payment', p_payment_id);
+    IF v_entry IS NULL THEN
+        RETURN;
+    END IF;
+    SELECT l.id, l.created_at INTO v_later_id, v_later_at
+      FROM public.account_ledger l
+     WHERE l.id = ANY (public.ledger_tree_ids(v_entry)) AND l.created_at > p_at
+     ORDER BY l.created_at DESC LIMIT 1;
+    IF FOUND AND p_at <> pg_catalog.now() THEN
+        RAISE EXCEPTION USING
+            MESSAGE = format('payment %s: %s is recorded at %s, a time chosen for it, before %s was recorded under the payment''s posting entry (money taken back or given back, at %s) — a history move is recorded after every row it follows (Opus B1, v5.4.2-23)', p_payment_id, p_what, p_at, v_later_id, v_later_at),
+            ERRCODE = 'check_violation';
+    END IF;
+    IF FOUND THEN
+        RAISE EXCEPTION USING
+            MESSAGE = format('payment %s: %s is recorded at %s, before %s was recorded under the payment''s posting entry (money taken back or given back, at %s) — a transaction that began earlier is writing later; retry it (Opus B1, v5.4.2-23)', p_payment_id, p_what, p_at, v_later_id, v_later_at),
+            ERRCODE = 'serialization_failure';
+    END IF;
+END;
+$$;
+COMMENT ON FUNCTION public.check_cash_leaving_order(uuid, timestamp with time zone, text) IS
+    'v5.4.2-23 r9 (Opus B1). For a payment with a live overpayment credit: refuses money leaving its family (a refund of the payment or a family credit moving to voided, nsf or reversed; a family credit''s void) recorded before a row under the payment''s posting entry: 40001 for a move stamped at its transaction''s start, 23514 for a chosen time. Keeps each take-back''s shares as recorded fixed once recorded. The caller holds the payment''s lock. Called by enforce_payment_immutable and enforce_customer_credit_immutable.';
+REVOKE ALL ON FUNCTION public.check_cash_leaving_order(uuid, timestamp with time zone, text) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION public.check_cash_leaving_order(uuid, timestamp with time zone, text) TO tally_app;
 
