CREATE UNIQUE INDEX service_order_field_visits_one_executed ON public.service_order_field_visits (service_order_id) WHERE outcome = 'executed';
CREATE UNIQUE INDEX service_order_field_visits_one_per_decision ON public.service_order_field_visits (collections_decision_id) WHERE collections_decision_id IS NOT NULL;
CREATE INDEX idx_field_visits_order ON public.service_order_field_visits (service_order_id, record_seq);
CREATE INDEX idx_field_visits_tenant ON public.service_order_field_visits (tenant_id);
COMMENT ON TABLE public.service_order_field_visits IS
    'v5.4.2-26 (F1, F2; CI-071, D9-1, D3A-1). A visit to a disconnect order, add-only, written by the field tool through the same API as any third-party tool: when the tech arrived (the caller''s fact), the meter serial and service point captured on site (as observed), what the database expected — the order''s location and its number, the order''s meter or else the one meter deployed at the location on the arrival date — and whether they match (case and surrounding blanks aside, and the expected meter deployed there that day: the address matching while the meter drifted is a mismatch). Outcome executed, or aborted with a reason (PA 56.94''s reasons; tariff options for a Texas city). An execution captures both values, cites its execute decision (eligible, live, the order''s location, that day), and needs a match or a supervisor''s mismatch approval, and evidence or a supervisor''s no-evidence approval — each of its own order and kind; under a mismatch approval it captures what the approved visit saw. One execution per order and per decision.';

CREATE TABLE public.service_order_field_approvals (
    id                  uuid DEFAULT public.uuid_generate_v4() NOT NULL,
    tenant_id           uuid NOT NULL,
    service_order_id    uuid NOT NULL,
    kind                text NOT NULL,
    visit_id            uuid,
    reason_code         text NOT NULL,
    evidence_ref        text,
    approved_by         uuid,
    created_at          timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT service_order_field_approvals_pkey PRIMARY KEY (id),
    CONSTRAINT service_order_field_approvals_id_tenant_id_key UNIQUE (id, tenant_id),
    CONSTRAINT service_order_field_approvals_order_fkey FOREIGN KEY (service_order_id, tenant_id) REFERENCES public.service_orders (id, tenant_id),
    CONSTRAINT service_order_field_approvals_visit_fkey FOREIGN KEY (visit_id, tenant_id) REFERENCES public.service_order_field_visits (id, tenant_id),
    CONSTRAINT service_order_field_approvals_approved_by_fkey FOREIGN KEY (approved_by) REFERENCES public.users (id),
    CONSTRAINT service_order_field_approvals_kind_check CHECK (kind = ANY (ARRAY['meter_mismatch', 'no_evidence'])),
    CONSTRAINT service_order_field_approvals_reason_code_check CHECK (reason_code ~ '^[a-z][a-z0-9_]*$')
);
CREATE INDEX idx_field_approvals_order ON public.service_order_field_approvals (service_order_id);
CREATE INDEX idx_field_approvals_tenant ON public.service_order_field_approvals (tenant_id);
COMMENT ON TABLE public.service_order_field_approvals IS
    'v5.4.2-26 (F3; D9-1, CI-071, R-38 attachment 2). A supervisor''s approval to execute a disconnect order despite a meter mismatch or without photo evidence, add-only: the order (a disconnect), the kind, a reason code, and the approver — stamped by the database from the session, which must be a supervisor (session_is_supervisor: a tenant_admin or a platform admin). A mismatch approval names the aborted, unmatched visit whose mismatch it approves and an evidence reference (lifting a protection needs evidence); a no-evidence approval names no visit. Each belongs to one order, and an order has one execution, so an approval is used once.';

ALTER TABLE public.service_order_field_visits
    ADD CONSTRAINT service_order_field_visits_mismatch_approval_fkey
        FOREIGN KEY (mismatch_approval_id, tenant_id) REFERENCES public.service_order_field_approvals (id, tenant_id),
    ADD CONSTRAINT service_order_field_visits_no_evidence_approval_fkey
        FOREIGN KEY (no_evidence_approval_id, tenant_id) REFERENCES public.service_order_field_approvals (id, tenant_id);

DO $$
DECLARE
    t text;
BEGIN
    FOREACH t IN ARRAY ARRAY['service_order_field_visits', 'service_order_field_approvals'] LOOP
        EXECUTE format('ALTER TABLE public.%I ENABLE ROW LEVEL SECURITY', t);
        EXECUTE format('ALTER TABLE public.%I FORCE ROW LEVEL SECURITY', t);
        EXECUTE format('CREATE POLICY tenant_isolation ON public.%I USING ((public.is_platform_admin() OR (tenant_id = public.get_user_tenant_id())))', t);
        EXECUTE format('CREATE TRIGGER a_stamp_created_at BEFORE INSERT ON public.%I FOR EACH ROW EXECUTE FUNCTION public.stamp_log_created_at()', t);
        EXECUTE format('ALTER TABLE public.%I ENABLE ALWAYS TRIGGER a_stamp_created_at', t);
        EXECUTE format('CREATE TRIGGER append_only BEFORE DELETE OR UPDATE ON public.%I FOR EACH ROW EXECUTE FUNCTION public.enforce_append_only()', t);
        EXECUTE format('ALTER TABLE public.%I ENABLE ALWAYS TRIGGER append_only', t);
        EXECUTE format('CREATE TRIGGER no_truncate BEFORE TRUNCATE ON public.%I FOR EACH STATEMENT EXECUTE FUNCTION public.enforce_no_hard_delete()', t);
        EXECUTE format('ALTER TABLE public.%I ENABLE ALWAYS TRIGGER no_truncate', t);
        EXECUTE format('REVOKE ALL ON public.%I FROM PUBLIC, tally_app, tally_core', t);
        EXECUTE format('GRANT SELECT, INSERT ON public.%I TO tally_app', t);
        EXECUTE format('GRANT SELECT ON public.%I TO tally_core', t);
    END LOOP;
END $$;


-- ----------------------------------------------------------------------------
-- 6. The acts' columns and keys (C7, E1)
-- ----------------------------------------------------------------------------
ALTER TABLE public.dunning_events ADD COLUMN collections_decision_id uuid;
-- One composite key binds the bill, its tenant and its customer (E1); the
-- name is kept (-19's check reads it: no cascade).
ALTER TABLE public.dunning_events DROP CONSTRAINT dunning_events_invoice_id_fkey;
ALTER TABLE public.dunning_events
    ADD CONSTRAINT dunning_events_invoice_id_fkey FOREIGN KEY (invoice_id, tenant_id, customer_id) REFERENCES public.invoices (id, tenant_id, customer_id),
    ADD CONSTRAINT dunning_events_decision_fkey FOREIGN KEY (collections_decision_id, tenant_id, customer_id)
        REFERENCES public.collections_decisions (id, tenant_id, customer_id);
CREATE UNIQUE INDEX dunning_events_one_per_decision ON public.dunning_events (collections_decision_id) WHERE collections_decision_id IS NOT NULL;
COMMENT ON COLUMN public.dunning_events.collections_decision_id IS
    'v5.4.2-26 (C7). The decision a gated step cites — shutoff_notice_sent (notice), late_fee_applied (late_fee), shutoff_scheduled (disconnect_order), disconnected (disconnect_execute), sent_to_collections (collections_referral) — and only those. A notice or a referral is the act: the live decision. A late fee, a scheduled shutoff and a disconnection are logged here after their own record (the charge, the order, the executed visit) cites the decision. One step per decision.';

ALTER TABLE public.adhoc_charges ADD COLUMN collections_decision_id uuid;
ALTER TABLE public.adhoc_charges
    ADD CONSTRAINT adhoc_charges_decision_fkey FOREIGN KEY (collections_decision_id, tenant_id, customer_id)
        REFERENCES public.collections_decisions (id, tenant_id, customer_id);
CREATE UNIQUE INDEX adhoc_charges_one_per_decision ON public.adhoc_charges (collections_decision_id) WHERE collections_decision_id IS NOT NULL;
COMMENT ON COLUMN public.adhoc_charges.collections_decision_id IS
    'v5.4.2-26 (C7). A late fee''s decision: the live, eligible late_fee decision for the bill it names (triggered_by_invoice_id), whose window covers its effective date. Required for a late fee, absent otherwise; written once, as is the late fee''s bill. One charge per decision.';

ALTER TABLE public.service_orders ADD COLUMN collections_decision_id uuid;
ALTER TABLE public.service_orders
    ADD CONSTRAINT service_orders_decision_fkey FOREIGN KEY (collections_decision_id, tenant_id, customer_id)
        REFERENCES public.collections_decisions (id, tenant_id, customer_id);
CREATE UNIQUE INDEX service_orders_one_per_decision ON public.service_orders (collections_decision_id) WHERE collections_decision_id IS NOT NULL;
COMMENT ON COLUMN public.service_orders.collections_decision_id IS
    'v5.4.2-26 (C7, F4). A disconnect order''s decision: the live, eligible disconnect_order decision for its location (and meter, when the decision names one) whose window covers the day the order is recorded. Required for a disconnect, absent otherwise; written once. One order per decision.';


-- ----------------------------------------------------------------------------
-- 7. The dunning guard and the stage (C7, E2)
-- ----------------------------------------------------------------------------
-- The act a dunning step is, when it is gated.
CREATE OR REPLACE FUNCTION public.collections_dunning_act(p_event_type text) RETURNS text
    LANGUAGE sql IMMUTABLE
    SET search_path = public, pg_temp
    AS $$
    SELECT CASE p_event_type WHEN 'shutoff_notice_sent' THEN 'notice' WHEN 'late_fee_applied' THEN 'late_fee'
                             WHEN 'shutoff_scheduled' THEN 'disconnect_order' WHEN 'disconnected' THEN 'disconnect_execute'
                             WHEN 'sent_to_collections' THEN 'collections_referral' END
$$;
COMMENT ON FUNCTION public.collections_dunning_act(text) IS
    'v5.4.2-26 (C7). The collections act a dunning step is, or NULL when the step is not gated (reminder_sent, reconnected, payment_plan_created, payment_plan_broken, written_off, resolved).';
REVOKE ALL ON FUNCTION public.collections_dunning_act(text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.collections_dunning_act(text) TO tally_app, tally_core;

-- The stage a dunning step moves its bill to (E2); NULL moves nothing.
CREATE OR REPLACE FUNCTION public.collections_dunning_stage(p_event_type text) RETURNS text
    LANGUAGE sql IMMUTABLE
    SET search_path = public, pg_temp
    AS $$
    SELECT CASE p_event_type WHEN 'reminder_sent' THEN 'reminder_sent' WHEN 'late_fee_applied' THEN 'late_fee_assessed'
                             WHEN 'shutoff_notice_sent' THEN 'shutoff_warning' WHEN 'shutoff_scheduled' THEN 'shutoff_scheduled'
                             WHEN 'disconnected' THEN 'disconnected' WHEN 'payment_plan_created' THEN 'payment_plan'
                             WHEN 'sent_to_collections' THEN 'collections' WHEN 'written_off' THEN 'written_off'
                             WHEN 'resolved' THEN 'resolved' END
$$;
COMMENT ON FUNCTION public.collections_dunning_stage(text) IS
    'v5.4.2-26 (E2). The dunning stage a step moves its bill to; reconnected and payment_plan_broken move none (no source says which stage follows them; residual R3).';
REVOKE ALL ON FUNCTION public.collections_dunning_stage(text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.collections_dunning_stage(text) TO tally_app, tally_core;

CREATE OR REPLACE FUNCTION public.enforce_dunning_event() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path = public, pg_temp
    AS $$
DECLARE
    v_act   text := public.collections_dunning_act(NEW.event_type);
    v_new   text := public.collections_dunning_stage(NEW.event_type);
    v_prev  text;
    v_log   boolean := NEW.event_type IN ('late_fee_applied', 'shutoff_scheduled', 'disconnected');
    d       public.collections_decisions%ROWTYPE;
BEGIN
    IF (v_act IS NULL) <> (NEW.collections_decision_id IS NULL) THEN
        RAISE EXCEPTION USING
            MESSAGE = format('dunning event: %s %s [A1] (v5.4.2-26)', NEW.event_type,
                             CASE WHEN v_act IS NULL THEN 'is not a gated act and cites no decision' ELSE 'is a collections act and cites its decision (act ' || v_act || ')' END),
            ERRCODE = 'check_violation';
    END IF;
    IF v_act IS NOT NULL THEN
        d := public.collections_act_check(NEW.collections_decision_id, v_act, NEW.invoice_id, NULL, NULL,
                                          (NEW.event_date AT TIME ZONE 'UTC')::date, NOT v_log, 'dunning event ' || NEW.event_type);
        -- A8 a log line needs the act's own record.
        IF (NEW.event_type = 'late_fee_applied'
              AND NOT EXISTS (SELECT 1 FROM public.adhoc_charges c WHERE c.collections_decision_id = d.id))
           OR (NEW.event_type = 'shutoff_scheduled'
              AND NOT EXISTS (SELECT 1 FROM public.service_orders o WHERE o.collections_decision_id = d.id))
           OR (NEW.event_type = 'disconnected'
              AND NOT EXISTS (SELECT 1 FROM public.service_order_field_visits v WHERE v.collections_decision_id = d.id)) THEN
            RAISE EXCEPTION USING
                MESSAGE = format('dunning event: %s logs an act, and no %s cites decision %s [A8] (v5.4.2-26)', NEW.event_type,
                                 CASE NEW.event_type WHEN 'late_fee_applied' THEN 'late-fee charge' WHEN 'shutoff_scheduled' THEN 'disconnect order'
                                                     ELSE 'executed field visit' END, d.id),
                ERRCODE = 'check_violation';
        END IF;
    END IF;

    -- E2 the stage: the bill's row is the stage's lock.
    SELECT i.dunning_stage INTO v_prev FROM public.invoices i WHERE i.id = NEW.invoice_id FOR NO KEY UPDATE;
    IF v_new IS NULL THEN
        IF NEW.new_stage IS NOT NULL OR NEW.previous_stage IS NOT NULL THEN
            RAISE EXCEPTION USING
                MESSAGE = format('dunning event: %s moves no stage and names none [E2b] (v5.4.2-26)', NEW.event_type),
                ERRCODE = 'check_violation';
        END IF;
    ELSE
        IF NEW.new_stage IS DISTINCT FROM v_new AND NEW.new_stage IS NOT NULL
           OR NEW.previous_stage IS DISTINCT FROM v_prev AND NEW.previous_stage IS NOT NULL THEN
            RAISE EXCEPTION USING
                MESSAGE = format('dunning event: %s moves the bill from %s to %s, not from %s to %s [E2b] (v5.4.2-26)', NEW.event_type, v_prev, v_new,
                                 coalesce(NEW.previous_stage, '(any)'), coalesce(NEW.new_stage, '(any)')),
                ERRCODE = 'check_violation';
        END IF;
        NEW.previous_stage := v_prev;
        NEW.new_stage      := v_new;
    END IF;
    RETURN NEW;
END;
$$;
COMMENT ON FUNCTION public.enforce_dunning_event() IS
    'v5.4.2-26 (C7, E2). BEFORE INSERT on dunning_events: a gated step cites a decision and no other does [A1]; the decision is checked by collections_act_check on the event''s UTC date — live for a notice or a referral, which are the act; for late_fee_applied, shutoff_scheduled and disconnected, which log an act with its own record, that record (the late-fee charge, the disconnect order, the executed visit) cites the decision [A8]. Then, under the bill''s row lock, fills previous_stage and new_stage from collections_dunning_stage, refusing a caller''s that disagree [E2b]; z_dunning_move_stage moves the bill.';
REVOKE ALL ON FUNCTION public.enforce_dunning_event() FROM PUBLIC, tally_app, tally_core;
CREATE TRIGGER b_enforce_dunning_event BEFORE INSERT ON public.dunning_events FOR EACH ROW EXECUTE FUNCTION public.enforce_dunning_event();
ALTER TABLE public.dunning_events ENABLE ALWAYS TRIGGER b_enforce_dunning_event;

CREATE OR REPLACE FUNCTION public.dunning_move_stage() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path = public, pg_temp
    AS $$
BEGIN
    IF NEW.new_stage IS NOT NULL THEN
        UPDATE public.invoices SET dunning_stage = NEW.new_stage WHERE id = NEW.invoice_id;
    END IF;
    RETURN NULL;
END;
$$;
COMMENT ON FUNCTION public.dunning_move_stage() IS
    'v5.4.2-26 (E2). AFTER INSERT on dunning_events: moves the bill''s dunning_stage to the event''s new_stage (the guard filled it). The only writer of invoices.dunning_stage (enforce_dunning_stage_projection fences every other).';
REVOKE ALL ON FUNCTION public.dunning_move_stage() FROM PUBLIC, tally_app, tally_core;
CREATE TRIGGER z_dunning_move_stage AFTER INSERT ON public.dunning_events FOR EACH ROW EXECUTE FUNCTION public.dunning_move_stage();
ALTER TABLE public.dunning_events ENABLE ALWAYS TRIGGER z_dunning_move_stage;

-- E2 the stage is written only by the move (a trigger at depth 1 updating
-- the bill: depth 2 here; memory trigger-depth-fence-inside-guard).
CREATE OR REPLACE FUNCTION public.enforce_dunning_stage_projection() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path = public, pg_temp
    AS $$
BEGIN
    IF pg_trigger_depth() < 2
       AND ((TG_OP = 'INSERT' AND NEW.dunning_stage IS DISTINCT FROM 'current')
            OR (TG_OP = 'UPDATE' AND NEW.dunning_stage IS DISTINCT FROM OLD.dunning_stage)) THEN
        RAISE EXCEPTION USING
            MESSAGE = format('bill %s: dunning_stage is the database''s — it moves when a dunning event is recorded; a bill is born at current [E2a] (v5.4.2-26)', NEW.id),
            ERRCODE = 'check_violation';
    END IF;
    RETURN NEW;
END;
$$;
COMMENT ON FUNCTION public.enforce_dunning_stage_projection() IS
    'v5.4.2-26 (E2). BEFORE INSERT OR UPDATE OF dunning_stage on invoices, for every role: a bill is born at current, and its stage changes only from dunning_move_stage (trigger depth 2) [E2a]. A trigger-depth fence: it holds while tally_app can define no code (residual R5).';
REVOKE ALL ON FUNCTION public.enforce_dunning_stage_projection() FROM PUBLIC, tally_app, tally_core;
CREATE TRIGGER a_enforce_dunning_stage_projection BEFORE INSERT OR UPDATE OF dunning_stage ON public.invoices
    FOR EACH ROW EXECUTE FUNCTION public.enforce_dunning_stage_projection();
ALTER TABLE public.invoices ENABLE ALWAYS TRIGGER a_enforce_dunning_stage_projection;
COMMENT ON COLUMN public.invoices.dunning_stage IS
    'Collections stage. v5.4.2-26: the database''s — the stage of the latest stage-moving dunning event (collections_dunning_stage), moved by dunning_move_stage; a bill is born at current and no one writes it directly.';

-- E3 the late-fee counters go: a bill''s late fees are its late_fee charges.
ALTER TABLE public.invoices DROP COLUMN late_fee_assessed, DROP COLUMN late_fee_amount;


-- ----------------------------------------------------------------------------
-- 8. Late-fee charges (C7)
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION public.enforce_adhoc_charge_decision() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path = public, pg_temp
    AS $$
BEGIN
    IF TG_OP = 'UPDATE' THEN
        IF NEW.collections_decision_id IS DISTINCT FROM OLD.collections_decision_id
           OR (OLD.collections_decision_id IS NOT NULL AND NEW.triggered_by_invoice_id IS DISTINCT FROM OLD.triggered_by_invoice_id) THEN
            RAISE EXCEPTION USING
                MESSAGE = format('charge %s: a late fee''s decision and bill are written once [A9] (v5.4.2-26)', NEW.id),
                ERRCODE = 'check_violation';
        END IF;
        RETURN NEW;
    END IF;
    IF (NEW.charge_type = 'late_fee') <> (NEW.collections_decision_id IS NOT NULL) THEN
        RAISE EXCEPTION USING
            MESSAGE = format('charge %s: %s [A1] (v5.4.2-26)', NEW.charge_number,
                             CASE WHEN NEW.charge_type = 'late_fee' THEN 'a late fee cites its late_fee decision' ELSE 'only a late fee cites a collections decision' END),
            ERRCODE = 'check_violation';
    END IF;
    IF NEW.collections_decision_id IS NOT NULL THEN
        PERFORM public.collections_act_check(NEW.collections_decision_id, 'late_fee', NEW.triggered_by_invoice_id, NULL, NULL,
                                             NEW.effective_date, true, 'late-fee charge ' || NEW.charge_number);
    END IF;
    RETURN NEW;
END;
$$;
COMMENT ON FUNCTION public.enforce_adhoc_charge_decision() IS
    'v5.4.2-26 (C7). BEFORE INSERT OR UPDATE OF collections_decision_id, triggered_by_invoice_id on adhoc_charges: a late fee cites its decision and no other charge does [A1]; the decision is the live, eligible late_fee decision for the bill the charge names, covering its effective date (collections_act_check); once cited, the decision and the bill are written once [A9].';
REVOKE ALL ON FUNCTION public.enforce_adhoc_charge_decision() FROM PUBLIC, tally_app, tally_core;
CREATE TRIGGER a_enforce_adhoc_charge_decision BEFORE INSERT OR UPDATE OF collections_decision_id, triggered_by_invoice_id ON public.adhoc_charges
    FOR EACH ROW EXECUTE FUNCTION public.enforce_adhoc_charge_decision();
# v5.4.2-26 design: collections decisions and field verification (2026-10-19)

**Authority:** Ryan, 2026-10-19: "go ahead with -26" (after -23 r3 stayed blocked on Kyle's K-10). Rulings: K-CCK (fail toward protection; CCK-7 grain), D9-1 (no-photo disconnect needs supervisor approval with a reason code), D3A-1 (the field tool is external), R-38 attachment 2 (a protection-lifting act needs a supervisor and an evidence reference), K-07 (no assumed defaults). Invariants: CI-067, CI-069, CI-071, CI-075, and CI-070's link to the decision.
**Spec:** `source-inventory-wave3.md`, sections E and F. Sources: `sources/gbm-sources.md` (CI-067/069/071/075, O1–O3, O8, O15, C5) and `sources/live-schema-at-22.md` (dunning_events, service_orders, invoices, customers, adhoc_charges).
**Builds on:** -25 (`pending_dispute` is no longer protective; disputes feed the core's `dispute` condition), -23 (invoices' `(id, tenant_id, customer_id)` key), -13 (`session_is_supervisor()`), the meter deployment record. It mirrors only after -23 and -25.
**Migration cost:** additive (three tables, a vocabulary, columns on four tables), plus four tightenings of existing tables: `dunning_events`, `service_orders`, the `invoices` projections (two columns dropped, one moved by the database) and `customers.do_not_disconnect`. Every table touched is empty everywhere. The patch stops, naming the row, if a database holds collections history it would have to reinterpret (the standing precondition, Ryan 2026-09-28: nothing is live).

As in -25: a call marked **(rule)** is settled by a standing rule and reported, not asked. **Corrections** are places where this design departs from the inventory's sketch, each with the rule that decides it.

## C: the decision record (CI-067, CI-069, CI-075)

- **C1. `collections_conditions`, a vocabulary.** The conditions a decision can name, platform-held:
  - **protections:** `dispute`, `payment_arrangement`, `agency_pledge`, `medical_hold`, `military_scra`, `weather_moratorium`, `regulatory_moratorium`, `bankruptcy_stay`, `deceased_hold`, `protected_status`, `tariff_protection` (a utility's own extra protection, Q-6);
  - **bars on the act:** `payment_pending`, `aged_suspense`, `third_party_notice_pending`, `notice_sequence_incomplete`, `arrears_below_floor`, `closed_day`, `elderly_due_date_delay`, `non_disconnectable_debt` (F-1, unregulated debt, carve-outs);
  - **missing rules:** `no_rule_in_force` (K-07: a city with no rule entered).

  Which conditions count for which act in which place is wave 7's rule data (A-14). The vocabulary only names them, so a decision can be read later.
- **C2. `collections_decisions`.** The core writes one row each time it decides whether a collections act may happen. Each row holds:
  - **the act:** `notice` (a disconnection notice), `late_fee`, `disconnect_order` (issuing the order), `disconnect_execute` (carrying it out) or `collections_referral`;
  - **the subject**, by act:

    | Act | Bill | Service location | Meter |
    |---|---|---|---|
    | `notice` | required | required | optional |
    | `late_fee`, `collections_referral` | required | none | none |
    | `disconnect_order`, `disconnect_execute` | none | required | optional |

    **Correction (rule: CCK-7).** The inventory put a notice at bill grain. Kyle's grain table puts a disconnect notice at "meter / service", so a notice names the bill it is for and the service it threatens. A late fee and a referral stay on the bill (dunning_events are per bill).
  - **the evaluation date** (the caller's; CI-075's "evaluation date", never the database's clock);
  - **the outcome:** `eligible`, `blocked` or `unevaluable`;
  - **`active_conditions`** (every bar that was active, CI-069's composition) and **`governing_condition`** (the one credited, for attribution only; C5 in the sources);
  - **`unevaluable_conditions`**: the conditions the core could not evaluate (O3);
  - **`valid_until`**, the last day an eligible decision authorizes an act (inclusive);
  - **its record:** `inputs`, `inputs_fingerprint`, `calculated_by` (the core version), a supersession link, a sequence number, `recorded_txid`, and `created_at` and `created_by`, both stamped.

  Written by `tally_app` with `calculated_by`, as `dispute_determinations` and `deposit_return_due` are. Add-only.
- **C3. What the database checks on a decision** (record integrity, not evaluation; memory `schema-represents-core-evaluates`):
  - **The subject's shape** follows the table above.
  - **The bill** is the customer's (composite FK) and issued.
  - **The service location** is the customer's. For a notice, it is the bill's own location when the bill names one.
  - **A meter** is deployed at the location on the evaluation date (`meter_deployments`).
  - **The outcome's shape:**
    - `eligible` has no conditions of either kind and a `valid_until` on or after the evaluation date;
    - `blocked` has at least one active condition, and the governing one is among them;
    - `unevaluable` has no active condition and at least one unevaluable one. If something is both active and unevaluable, the decision is `blocked`: a bar that is known holds whatever else is unknown;
    - a non-eligible decision has no `valid_until` and holds until the next decision;
    - every condition comes from the vocabulary, with no repeats.
  - **An execute decision holds for its own day only:** an eligible `disconnect_execute` has `valid_until` equal to its evaluation date. **(Rule: fail toward protection.)** EWE is evaluated per day, and GBM's rank 0 refuses a disconnect that relies on an older evaluation.
  - **No future evaluation:** the evaluation date is on or before the database's current UTC date (the -23 convention for a timestamp's date). Otherwise a core could pre-authorize tomorrow's execution on today's facts.
- **C4. One live decision per act and subject.** A first decision for an (act, subject) names nothing. A later one names the live decision it supersedes, under the subject's advisory lock, as `dispute_determinations` do (memory `count-guards-need-lock-handshake`). Its evaluation date is no earlier than the live one's.
- **C5. Idempotent against the live decision (CI-075).** A decision whose evaluation date and fingerprint equal the live decision's is refused: the engine re-ran on the same facts. Different facts on the same date (a payment arrived) give a new row.

  **Correction (rule: memory `append-only-vs-unique-deadlock`).** The inventory sketched a unique key over (act, subject, date, fingerprint) across all rows. That wedges: a payment arrives (inputs A to B), then bounces the same day (B back to A), and the unique key refuses the decision that would restore "eligible" for ever. The check compares against the live row only.
- **C6. Unevaluable blocks (rule: fail toward protection; K-CCK, R-26, R-30).** No law says it; it is a design rule, recorded here and in the vocabulary's comment. Only an `eligible` decision authorizes an act (C7).
- **C7. Acts cite their decision.** Each act names an eligible, live decision for the same act and subject, whose window (evaluation date to `valid_until`) covers the act's date. The act takes the subject's lock first, so a newer decision that commits first is seen and the act is refused. One act per decision.

  | Act recorded as | Decision act | Act's date | Also needs |
  |---|---|---|---|
  | `dunning_events` `shutoff_notice_sent` | `notice` | `event_date` (UTC date) | |
  | `dunning_events` `late_fee_applied` | `late_fee` | `event_date` | the late-fee charge citing the decision |
  | `adhoc_charges` of type `late_fee` | `late_fee` | `effective_date` | names its bill (`triggered_by_invoice_id`) |
  | `service_orders` of type `disconnect`, at insert | `disconnect_order` | the insert's UTC date | the order's customer, location and meter match |
  | `dunning_events` `shutoff_scheduled` | `disconnect_order` | `event_date` | the disconnect order citing the decision |
  | `service_order_field_visits` with outcome `executed` | `disconnect_execute` | `arrived_at` (UTC date) | (F1) |
  | `dunning_events` `disconnected` | `disconnect_execute` | `event_date` | the executed visit citing the decision |
  | `dunning_events` `sent_to_collections` | `collections_referral` | `event_date` | |

  The other dunning types (`reminder_sent`, `reconnected`, `payment_plan_created`, `payment_plan_broken`, `written_off`, `resolved`) cite no decision. They are not collections acts against the customer, and none of the sources gates them. The "Also needs" column ties the log to the act it records, so a log line cannot claim a disconnection that no visit performed. This is record integrity (which decision authorized the act), never evaluation.

  **The act and its log line (found writing the tests).** Where the act has its own record (the late-fee charge, the disconnect order, the executed visit), that record is the act: it is checked against the live decision when it is written. The `dunning_events` line that logs it (`late_fee_applied`, `shutoff_scheduled`, `disconnected`) cites the same decision. It needs that record to exist and its own date inside the decision's window, but not the decision to be live still. Requiring liveness would refuse an honest log line whenever the next day's sweep had already written a newer decision, and the act it records was authorized when it happened. A `shutoff_notice_sent` or `sent_to_collections` line has no other record: it is the act, so it needs the live decision.
- **C8. A blocked decision is the bypass trace (O2).** GBM's `bypass_applied` is the `blocked` row itself, so `dunning_events` gets no new types.
- **C9. Rule citations wait for wave 7 (rule: memory `frame-shapes-by-migration-cost`).** No collections rule table exists yet: moratoria, notice sequences, late fees and bypass sets are wave 7. Until then a decision records the rule versions it read in `inputs`, under its fingerprint and `calculated_by`. A citation table with close-floor locks is additive when the first collections rule table lands. Building it now would mean re-creating every rule table's close floor for a citation nothing can make.

## E: hardening what already exists

- **E1. `dunning_events` (CI-075):**
  - customer, invoice and tenant are bound by composite keys `(invoice_id, tenant_id, customer_id)` and `(customer_id, tenant_id)`;
  - a new column `collections_decision_id`, required for the five gated types and absent for the others (C7), bound by a composite key to the decision's tenant and customer;
  - one event per decision (a unique index).
- **E2. The bill's stage is the database's.** `invoices.dunning_stage` moves only when a `dunning_events` row is inserted, and the database moves it (memory `guards-must-act-not-record`). The event's `previous_stage` and `new_stage` are filled by the database, and a caller value that disagrees is refused. A direct write to `dunning_stage` is refused. The mapping is fixed:

  | Event | Stage |
  |---|---|
  | `reminder_sent` | `reminder_sent` |
  | `late_fee_applied` | `late_fee_assessed` |
  | `shutoff_notice_sent` | `shutoff_warning` |
  | `shutoff_scheduled` | `shutoff_scheduled` |
  | `disconnected` | `disconnected` |
  | `payment_plan_created` | `payment_plan` |
  | `sent_to_collections` | `collections` |
  | `written_off` | `written_off` |
  | `resolved` | `resolved` |
  | `reconnected`, `payment_plan_broken` | no move |

  The stage is the latest stage-moving event's. Nothing says which stage follows a reconnection or a broken plan, so those two move nothing (residual R3). The next act moves the stage again.
- **E3. `invoices.late_fee_assessed` and `late_fee_amount` go (rule: wave 2's M1, derive, do not store).** A bill's late fees are its `late_fee` charges (`adhoc_charges` naming it). No function or view reads the two columns (catalog search, 2026-10-19).
- **E4. `customers.do_not_disconnect` is written only by `recompute_do_not_disconnect` (memory `guards-must-act-not-record`).** A customer is born with it false. A change from any statement that is not the enrollment trigger's is refused: the trigger-depth fence `pg_trigger_depth() < 2` (memories `trigger-depth-fence-inside-guard`, `depth-fence-needs-no-temp`). Protection comes from a program enrollment.
  - **For Kyle (not blocking):** the account-detail UI concept edits `do_not_disconnect` as a checkbox (`ui-concepts/components/accounts/AccountDetail.tsx`). After -26 that screen enrolls the customer in a protective program instead.

## F: field verification (CI-071, D9-1)

- **F1. `service_order_field_visits`.** Add-only, one row per visit to a disconnect order. The field tool writes it through the same API as any third-party tool (D3A-1). Each visit records:
  - **arrival:** `arrived_at`, the caller's fact;
  - **as observed:** `captured_meter_serial` and `captured_location_number` (the service point the tech read on site), as `meter_tests.meter_serial_at_test` records a field value;
  - **expected, filled by the database:** the order's location and its `location_number`, the expected meter and its serial. The expected meter is the order's meter, or the one meter deployed at the location on the arrival date when the order names none;
  - **`matched`, computed by the database:** the captured serial and location number equal the expected ones (case and surrounding blanks aside), and the expected meter is deployed at the order's location on the arrival date. So "the address matches but the meter drifted" is a mismatch (axis A14). With no single deployed meter to expect, nothing can match;
  - **outcome:** `executed` or `aborted`. An abort names its reason: `meter_mismatch`, `payment_shown`, `medical_evidence`, `dispute_pending`, `no_access`, `safety` or `other`. PA §56.94 supplies the reasons; for a Texas city they are tariff options, recorded when they happen (memory `launch-scope-is-not-architecture-scope`);
  - **evidence:** `evidence_refs`, a list of references that may be empty.
- **F2. What an executed visit needs:**
  - the order is a disconnect order, not completed, cancelled or superseded;
  - an eligible, live `disconnect_execute` decision for the order's customer and location (and its meter, if the decision names one), covering the arrival date (C7);
  - a match, or a supervisor's `meter_mismatch` approval for this order (F3);
  - at least one evidence reference, or a supervisor's `no_evidence` approval for this order (D9-1);
  - at most one executed visit per order.
- **F3. `service_order_field_approvals`: an override is a supervisor's act (D9-1; CI-071's override failure; memory `guard-the-act-not-the-label`).** Add-only. Each approval names:
  - the order and its kind: `meter_mismatch` or `no_evidence`;
  - a reason code;
  - for `meter_mismatch`, the aborted, unmatched visit whose mismatch it approves and an evidence reference (**rule: R-38 attachment 2**: lifting a protection needs a supervisor and an evidence artifact). The executing visit must then capture the same serial and location number that visit did, so the supervisor approves executing against the meter that was actually seen;
  - **`approved_by`, stamped by the database from the session.** The session must be a supervisor (`session_is_supervisor()`: tenant_admin or platform admin, the -13 meaning). A caller cannot name someone else as the approver.

  An approval belongs to one order, and an order has at most one executed visit, so an approval is used once without a guard of its own.
- **F4. A disconnect order is guarded.**
  - **At insert** it cites an eligible `disconnect_order` decision (C7) and cannot be born `completed`.
  - **Write-once:** its type, customer, location, meter and decision. An order cannot be retargeted after its approval, and no order can change into or out of `disconnect`.
  - **Completion:** it reaches `completed` only with an executed visit, and stays there.
  - **Cancellation:** once a visit has executed, the order can only be completed, never cancelled or put on hold.

  Other order types stay as they are.

  **Correction (rule: memory `guard-the-act-not-the-label`, YAGNI).** The inventory added "every other status move names its cause". The regulated act is the disconnection: issuing it, executing it and recording it. Moves between `scheduled`, `dispatched` and `in_progress` are dispatch bookkeeping, and no source asks for their cause. Guarding them would add a cause column nothing reads.

## Lock order (a rule)

A write takes, in this order:
1. **the subject's advisory lock** (`collections_subject_lock`), keyed by (tenant, act, customer, bill, location, meter). It is taken by a decision, and by an act citing one (READ COMMITTED only, 25000 otherwise, as `dispute_lock`);
2. **for a visit, the order's row** (`FOR KEY SHARE`; an order update holds its row lock already);
3. nothing else.

A decision takes only its own subject's lock. An act takes the lock of the decision it cites, read from the decision's row, which is write-once.

## Tests (written first)

- **battery-26:**
  - **V:** the vocabulary, the grants and the new columns.
  - **C:** the decision record, one refusal per C3–C5 bullet, both sides of each boundary. Covered: the window's last day, the execute decision's single day, today against tomorrow, the same fingerprint against a new one on the same day, and the A→B→A sequence.
  - **A:** each row of the C7 table: the act with a good decision, then with a blocked one, an unevaluable one, a superseded one, another subject's, another act's, one outside its window, and a decision already used.
  - **E:** the dunning keys, the stage mapping row by row, the refused direct stage write, the dropped columns, and the `do_not_disconnect` fence (the enrollment path moves it; a direct write, an insert as true and a write from a superuser's session each behave as stated).
  - **F:** the visit's computed expectations (order meter, deployed meter, none deployed, drifted meter), the executed visit's needs, the approvals (a non-supervisor refused, approver stamped, mismatch values bound, one use), and the order guard.
  - **H:** history, grants, tenancy, append-only, no truncate.

  Every exempt branch has a fixture that takes it (memory `every-branch-and-stated-default-tested`).
- **Races** (`races/collections-26.sh`):
  - two decisions for one subject, so one live row survives;
  - an act against a decision that a concurrent new decision supersedes, both orders;
  - two acts citing one decision;
  - two executed visits for one order;
  - one approval used twice;
  - the READ COMMITTED pin.
- **Mutations** (`mutations-26.py`), from -25's runner: every guard is the first thing that refuses.
- **Migration** (`migration-26.py`): a strict apply on a -25 base; a second apply changes nothing; and the stop conditions, each naming its row:
  - a `dunning_events` row;
  - a bill not at stage `current`;
  - a bill with a late fee recorded on it;
  - a `late_fee` charge;
  - a disconnect order;
  - a customer whose `do_not_disconnect` disagrees with their enrollments.

## Open for the build (mine, by rule)

1. **How the act's date is read from a timestamp:** the UTC date, as -23 reads `escheatment_events.event_date`. A local-time reading needs a time zone per bill that the schema does not hold for every bill (R1).
2. **Serial comparison:** `upper(btrim(…))` on both sides. A false mismatch is fail-safe; a false match is not, so nothing looser.
3. **Whether `disconnected` needs the executed visit to be its own order's:** yes, through the decision. A visit and an event cite the same execute decision, which names one subject.

## Residuals (expected; the patch header carries the final list)

- **R1.** Act dates are UTC dates. An act late in a Texas evening falls on the next day's date, and so would a decision evaluated then.
- **R2.** Rule citations wait for wave 7 (C9). Until then the decision's rule versions are in its `inputs`.
- **R3.** `reconnected` and `payment_plan_broken` move no stage.
- **R4.** Whether a city owes *Craft* due process before a disconnect is the core's evaluation, recorded as a condition. The database does not infer it.
- **R5.** The `do_not_disconnect` fence is a trigger-depth fence. It holds while tally_app can define no code (TEMP revoked; memory `template-clone-drops-acl`).

## Tests as written (2026-10-19, before the patch)

All of these fail first, at the first object -26 creates. They join `tests/ci.sh` with the patch.

- **`tests/v5.4.2-26/battery-26.sql`:** about 190 checks in groups V, C, A, E, F and H. The fixtures run cleanly on a -25 base. The header fixes the contract:
  - table, column and constraint names;
  - every refusal the patch raises itself carries its requirement tag in brackets (e.g. `[C3f]`), and the checks match on the tag.

  A bill with no location is a consolidated bill (`invoices_check`), so fixture bill 02 is consolidated.
- **`tests/v5.4.2-26/races/collections-26.sh`**, CR1–CR7:
  - one live decision under two writers;
  - an act against a concurrent supersession, both orders;
  - two acts on one decision;
  - two executions under one decision;
  - two stage moves on one bill (the bill's row is the stage's lock);
  - the READ COMMITTED pin.
- **`tests/v5.4.2-26/migration-26.py`**, P0–P7:
  - a strict apply;
  - a second apply that changes nothing;
  - the six stop conditions, each naming its row.

**Lock order, amended from the tests:** a dunning event also locks its bill's row (`FOR NO KEY UPDATE`) after the subject's lock, so two events on one bill read and move the stage in turn (CR6).

## Built (2026-10-19, `sql/v5.4.2-26-collections-decisions.sql`)

Ryan, 2026-10-19: "go ahead with -26". What the build settled, by rule:

- **Tenant checks.** Only the field visit keeps one (`collections_tenant_check`). Its guard reads the order first, so another tenant's visit would otherwise be refused as "not found" (H2). In the decision and approval guards, nothing answers before row security does, so a tenant check there could never be the first refusal, and it was removed (the -25 finding).
- **The live decision is the latest recorded for its subject.** Every decision after the first supersedes the live one under the subject's lock, so a separate "no successor" filter could never matter. The act check's own liveness test (`supersedes_id = d.id`) stays.
- **A blocked decision with nothing active** is refused by the check that its credited condition is active, so a separate emptiness test was removed.
- **Visits vs order status.** A visit takes its order's row `FOR SHARE`, which an order's status update conflicts with. Cancelling an order while a crew records its execution resolves one way or the other, never as a cancelled order with an execution on it (CR8, CR8b, added during the build).
- **An execution records both captured values** ([F2e]), CI-071's "captured-vs-expected pair not recorded". A visit that could not read the meter may leave them empty only when it aborts.
- **Captured fields are nullable** for that reason: a "no access" abort may have nothing to capture.

Test corrections (the tests were wrong, not the patch):
- **V1** compared the vocabulary in the wrong order: `aged_suspense` sorts before `agency_pledge`. It now sorts with `COLLATE "C"`.
- **Bill 02** (no location) must be a consolidated bill (`invoices_check`).
- **A5b and A5g** first matched a different refusal. Each customer mismatch the composite keys catch needed a fixture where the guard's own checks pass: A5b is a disconnection log under another customer's execute decision; A5g is an order at the decision's location but for another customer.

Mutations (`tests/v5.4.2-26/mutations-26.py`): 127 of 127 caught, each at the first check that fails. Writing it found:
- **Branches no test reached**, now tested:
  - C3f15 (eligible crediting a condition);
  - C3f16 (unevaluable with a last day);
  - C3g4 (an unevaluable condition named twice);
  - A0 as one check, with A0's O7 (subjects that differ only by meter);
  - A4d (an order citing a superseded decision);
  - A9a–A9c (a late fee's decision and bill written once);
  - F1c3 (an abort citing a decision);
  - F1p (the right serial at the wrong service point);
  - F2a6 (an execution capturing nothing);
  - F3b8 (a mismatch approval naming an execution).
- **Four mutations renamed** to the earlier check that rightly catches them first: M19 (C3f6), M54 (A5g, the first act dated on its decision's day), M62 (CR6b), M129 (V4).
- **Not mutated:** the `ENABLE ALWAYS` flags, which differ only in a replication session, and the battery runs none.

Result:

| Check | Result |
|---|---|
| battery-26 | 202 checks |
| races CR1–CR8 | 11 results |
| migration | P0–P7 pass (22 checks) |
| mutations | 127 of 127 |
| `tests/ci.sh` | all pass (49 steps) |

**At mirror:** APPLICATION-CONTRACTS needs updating. AC-10 lists `dunning_stage` and `late_fee_*` as writable; AC-37 should say a gated dunning step cites its decision. Add a new contract for decisions, visits and approvals.

