 pg_temp.visit('TSV','TS',now()-interval '1 second','SN-E1','L1','executed',NULL,'TSX',NULL,NULL,'{photo-ts}'));
SELECT pg_temp.observe('caller lowers the order bound',format('UPDATE public.service_orders SET created_at=now()-interval ''2 seconds'' WHERE id=%L',pg_temp.id('TS')));
