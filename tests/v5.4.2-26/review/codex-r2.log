COMMENT ON COLUMN public.dunning_events.collections_decision_id IS
    'v5.4.2-26 (C7). The decision a gated step cites — shutoff_notice_sent (notice), late_fee_applied (late_fee), shutoff_scheduled (disconnect_order), disconnected (disconnect_execute), sent_to_collections (collections_referral) — and only those. A notice or a referral is the act: the live decision. A late fee, a scheduled shutoff and a disconnection are logged here after their own record (the charge, the order, the executed visit) cites the decision. One step per decision and bill (a disconnection is logged on each bill of its customer it rests on).';

ALTER TABLE public.adhoc_charges ADD COLUMN collections_decision_id uuid;
ALTER TABLE public.adhoc_charges
    ADD CONSTRAINT adhoc_charges_decision_fkey FOREIGN KEY (collections_decision_id, tenant_id, customer_id)
        REFERENCES public.collections_decisions (id, tenant_id, customer_id);
CREATE UNIQUE INDEX adhoc_charges_one_per_decision ON public.adhoc_charges (collections_decision_id) WHERE collections_decision_id IS NOT NULL;
COMMENT ON COLUMN public.adhoc_charges.collections_decision_id IS
    'v5.4.2-26 (C7). A late fee''s decision: the live, eligible late_fee decision for the bill it names (triggered_by_invoice_id), whose window covers its effective date. Required for a late fee, absent otherwise; written once, as is the late fee''s bill. One charge per decision.';

ALTER TABLE public.service_orders ADD COLUMN collections_decision_id uuid;
ALTER TABLE public.service_orders
    ADD CONSTRAINT service_orders_decision_fkey FOREIGN KEY (collections_decision_id, tenant_id, customer_id)
        REFERENCES public.collections_decisions (id, tenant_id, customer_id);
CREATE UNIQUE INDEX service_orders_one_per_decision ON public.service_orders (collections_decision_id) WHERE collections_decision_id IS NOT NULL;
COMMENT ON COLUMN public.service_orders.collections_decision_id IS
    'v5.4.2-26 (C7, F4). A disconnect order''s decision: the live, eligible disconnect_order decision for its location (and meter, when the decision names one) whose window covers the day the order is recorded. Required for a disconnect, absent otherwise; written once. One order per decision.';


-- ----------------------------------------------------------------------------
-- 7. The dunning guard and the stage (C7, E2)
-- ----------------------------------------------------------------------------
-- The act a dunning step is, when it is gated.
CREATE OR REPLACE FUNCTION public.collections_dunning_act(p_event_type text) RETURNS text
    LANGUAGE sql IMMUTABLE
    SET search_path = public, pg_temp
    AS $$
    SELECT CASE p_event_type WHEN 'shutoff_notice_sent' THEN 'notice' WHEN 'late_fee_applied' THEN 'late_fee'
                             WHEN 'shutoff_scheduled' THEN 'disconnect_order' WHEN 'disconnected' THEN 'disconnect_execute'
                             WHEN 'sent_to_collections' THEN 'collections_referral' END
$$;
COMMENT ON FUNCTION public.collections_dunning_act(text) IS
    'v5.4.2-26 (C7). The collections act a dunning step is, or NULL when the step is not gated (reminder_sent, reconnected, payment_plan_created, payment_plan_broken, written_off, resolved).';
REVOKE ALL ON FUNCTION public.collections_dunning_act(text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.collections_dunning_act(text) TO tally_app, tally_core;

-- The stage a dunning step moves its bill to from the stage it is at (E2);
-- NULL moves nothing. r2 (Opus S1, Fable S1, Codex N2; settled by rule, plan
-- r2 item 6): the escalation steps move a bill only forward along the
-- ladder current -> reminder_sent -> late_fee_assessed -> shutoff_warning ->
-- shutoff_scheduled -> disconnected -> collections, so a repeat late fee
-- (a monthly penalty, Ryan 2026-11-22) or a later reminder leaves a bill
-- further along where it is. From a stage off the ladder (payment_plan,
-- resolved, written_off) an escalation step moves it to the step's stage:
-- collections resumed. A plan, a write-off and a resolution move as named.
CREATE OR REPLACE FUNCTION public.collections_dunning_stage(p_event_type text, p_from text) RETURNS text
    LANGUAGE sql IMMUTABLE
    SET search_path = public, pg_temp
    AS $$
    WITH t AS (
        SELECT CASE p_event_type WHEN 'reminder_sent' THEN 'reminder_sent' WHEN 'late_fee_applied' THEN 'late_fee_assessed'
                                 WHEN 'shutoff_notice_sent' THEN 'shutoff_warning' WHEN 'shutoff_scheduled' THEN 'shutoff_scheduled'
                                 WHEN 'disconnected' THEN 'disconnected' WHEN 'payment_plan_created' THEN 'payment_plan'
                                 WHEN 'sent_to_collections' THEN 'collections' WHEN 'written_off' THEN 'written_off'
                                 WHEN 'resolved' THEN 'resolved' END AS target,
               p_event_type IN ('reminder_sent', 'late_fee_applied', 'shutoff_notice_sent', 'shutoff_scheduled', 'disconnected', 'sent_to_collections') AS escalation,
               ARRAY['current', 'reminder_sent', 'late_fee_assessed', 'shutoff_warning', 'shutoff_scheduled', 'disconnected', 'collections'] AS ladder)
        -- The visit's keys bind the order and the decision to the tenant
        -- only, and a location can change customer.
        IF d.customer_id IS DISTINCT FROM o.customer_id THEN
            RAISE EXCEPTION USING
                MESSAGE = format('execution of order %s: decision %s is customer %s''s, the order customer %s''s [A5] (v5.4.2-26)', o.order_number, d.id, d.customer_id, o.customer_id),
                ERRCODE = 'check_violation';
        END IF;
        -- r2 (Opus S3): an execution is not dated before its order or its
        -- decision was recorded, nor in the future.
        IF NEW.arrived_at < o.created_at OR NEW.arrived_at < d.created_at OR NEW.arrived_at > pg_catalog.now() THEN
            RAISE EXCEPTION USING
                MESSAGE = format('execution of order %s: arrived %s, before the order (%s) or its decision (%s) was recorded, or in the future [F2f] (v5.4.2-26)',
                                 o.order_number, NEW.arrived_at, o.created_at, d.created_at),
                ERRCODE = 'check_violation';
        END IF;
    END IF;
    -- The order's row (FOR SHARE: a status update of the order waits for this
    -- visit, and this visit for it), then its status.
    SELECT * INTO o FROM public.service_orders x WHERE x.id = NEW.service_order_id FOR SHARE;
    IF o.status IN ('completed', 'cancelled', 'superseded') THEN
        RAISE EXCEPTION USING
            MESSAGE = format('field visit: order %s is %s [F1b] (v5.4.2-26)', o.order_number, o.status),
            ERRCODE = 'check_violation';
    END IF;

    -- F1 what was expected, and whether it matches: the database's.
    IF o.meter_id IS NOT NULL THEN
        v_meter := o.meter_id;
    ELSE
        SELECT array_agg(m.meter_id) INTO v_ids FROM public.meter_deployments m
         WHERE m.location_id = o.location_id AND daterange(m.install_date, m.removal_date, '[)') @> v_on;
        v_meter := CASE WHEN cardinality(v_ids) = 1 THEN v_ids[1] END;
    END IF;
    NEW.expected_location_id     := o.location_id;
    NEW.expected_location_number := (SELECT l.location_number FROM public.service_locations l WHERE l.id = o.location_id);
    NEW.expected_meter_id        := v_meter;
    NEW.expected_meter_serial    := (SELECT m.serial_number FROM public.meters m WHERE m.id = v_meter);
    NEW.matched := coalesce(v_meter IS NOT NULL
                            AND EXISTS (SELECT 1 FROM public.meter_deployments m
                                         WHERE m.meter_id = v_meter AND m.location_id = o.location_id
                                           AND daterange(m.install_date, m.removal_date, '[)') @> v_on)
                            AND upper(btrim(NEW.captured_meter_serial)) = upper(btrim(NEW.expected_meter_serial))
                            AND upper(btrim(NEW.captured_location_number)) = upper(btrim(NEW.expected_location_number)), false);
    IF EXISTS (SELECT 1 FROM unnest(NEW.evidence_refs) r WHERE r IS NULL OR r !~ '[[:alnum:]]') THEN
        RAISE EXCEPTION USING
            MESSAGE = 'field visit: an evidence reference is blank [F1e] (v5.4.2-26)',
            ERRCODE = 'check_violation';
    END IF;

    -- F2, F3 an execution's needs.
    IF NEW.outcome = 'executed' THEN
        -- r2 (Fable S3): a captured value has an alphanumeric character.
        IF NOT coalesce(NEW.captured_meter_serial ~ '[[:alnum:]]' AND NEW.captured_location_number ~ '[[:alnum:]]', false) THEN
            RAISE EXCEPTION USING
                MESSAGE = format('field visit: an execution of order %s records the serial and service point captured on site (CI-071) [F2e] (v5.4.2-26)', o.order_number),
                ERRCODE = 'check_violation';
        END IF;
        -- r2 (Codex S1, Fable S6): an approval is named only where needed.
        IF (NEW.matched AND NEW.mismatch_approval_id IS NOT NULL)
           OR (cardinality(NEW.evidence_refs) > 0 AND NEW.no_evidence_approval_id IS NOT NULL) THEN
            RAISE EXCEPTION USING
                MESSAGE = format('field visit: an execution of order %s names an approval it does not need (a mismatch approval on a match, or a no-evidence approval with evidence) [F3e] (v5.4.2-26)', o.order_number),
                ERRCODE = 'check_violation';
        END IF;
        IF NOT NEW.matched THEN
            IF NEW.mismatch_approval_id IS NULL THEN
                RAISE EXCEPTION USING
                    MESSAGE = format('field visit: %s / %s captured, %s / %s expected — a mismatch halts the disconnect unless a supervisor approves it [F2b] (v5.4.2-26)',
                                     NEW.captured_meter_serial, NEW.captured_location_number, coalesce(NEW.expected_meter_serial, 'no single meter'), NEW.expected_location_number),
                    ERRCODE = 'check_violation';
            END IF;
            SELECT * INTO a FROM public.service_order_field_approvals x WHERE x.id = NEW.mismatch_approval_id;
            IF NOT FOUND OR a.service_order_id <> o.id OR a.kind <> 'meter_mismatch' THEN
                RAISE EXCEPTION USING
                    MESSAGE = format('field visit: approval %s is not a mismatch approval of order %s [F3d] (v5.4.2-26)', NEW.mismatch_approval_id, o.order_number),
                    ERRCODE = 'check_violation';
            END IF;
            SELECT * INTO av FROM public.service_order_field_visits x WHERE x.id = a.visit_id;
            IF upper(btrim(av.captured_meter_serial)) IS DISTINCT FROM upper(btrim(NEW.captured_meter_serial))
               OR upper(btrim(av.captured_location_number)) IS DISTINCT FROM upper(btrim(NEW.captured_location_number)) THEN
                RAISE EXCEPTION USING
                    MESSAGE = format('field visit: approval %s approved executing against %s / %s, not %s / %s [F3c] (v5.4.2-26)', a.id,
                                     av.captured_meter_serial, av.captured_location_number, NEW.captured_meter_serial, NEW.captured_location_number),
                    ERRCODE = 'check_violation';
            END IF;
        END IF;
        IF cardinality(NEW.evidence_refs) = 0 THEN
            IF NEW.no_evidence_approval_id IS NULL THEN
                RAISE EXCEPTION USING
                    MESSAGE = format('field visit: an execution of order %s with no evidence needs a supervisor''s approval (D9-1) [F2c] (v5.4.2-26)', o.order_number),
                    ERRCODE = 'check_violation';
            END IF;
            SELECT * INTO a FROM public.service_order_field_approvals x WHERE x.id = NEW.no_evidence_approval_id;
            IF NOT FOUND OR a.service_order_id <> o.id OR a.kind <> 'no_evidence' THEN
                RAISE EXCEPTION USING
                    MESSAGE = format('field visit: approval %s is not a no-evidence approval of order %s [F3d] (v5.4.2-26)', NEW.no_evidence_approval_id, o.order_number),
                    ERRCODE = 'check_violation';
            END IF;
        END IF;
    END IF;

    NEW.record_seq := nextval('public.collections_record_seq');
    BEGIN
        NEW.created_by := NULLIF(current_setting('app.user_id', true), '')::uuid;
    EXCEPTION WHEN OTHERS THEN
        NEW.created_by := NULL;
    END;
    RETURN NEW;
END;
$$;
COMMENT ON FUNCTION public.enforce_field_visit() IS
    'v5.4.2-26 (F1-F3; C7). BEFORE INSERT on service_order_field_visits: the writer''s own tenant; a disconnect order [F1a]; an execution cites its decision [A1], checked by collections_act_check against the order''s location and meter on the arrival''s UTC date (live, eligible, that day); then under the order''s row (FOR SHARE) the order is open [F1b]. Fills the expectation (the order''s location and number; its meter, or the one meter deployed there that day) and the match (both captured values, case and blanks aside, and the expected meter deployed there that day), overwriting any the caller gave; no blank evidence reference [F1e]. An execution captures both values, each with an alphanumeric character [F2e], cites a decision for the order''s customer [A5], and is dated no earlier than its order and its decision were recorded and not in the future [F2f]; on a mismatch it names a mismatch approval [F2b] of its order [F3d] and captures what the approved visit saw [F3c]; with no evidence, a no-evidence approval [F2c] of its order [F3d]; it names no approval it does not need [F3e]. Stamps created_by and record_seq.';
REVOKE ALL ON FUNCTION public.enforce_field_visit() FROM PUBLIC, tally_app, tally_core;
CREATE TRIGGER b_enforce_field_visit BEFORE INSERT ON public.service_order_field_visits FOR EACH ROW EXECUTE FUNCTION public.enforce_field_visit();
ALTER TABLE public.service_order_field_visits ENABLE ALWAYS TRIGGER b_enforce_field_visit;

CREATE OR REPLACE FUNCTION public.enforce_field_approval() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path = public, pg_temp
    AS $$
DECLARE
    o       public.service_orders%ROWTYPE;
    v       public.service_order_field_visits%ROWTYPE;
    v_user  uuid;
BEGIN
    -- Another tenant's approval is row security's to refuse.
    -- r2 (Opus B4, Fable S4, Codex S2; R-12, the Tally User ruling of
    -- 2026-11-07): the approver is a tenant_admin of the order's own utility —
    -- Tally staff act through that utility's Tally User, never as themselves.
    BEGIN
        v_user := NULLIF(current_setting('app.user_id', true), '')::uuid;
    EXCEPTION WHEN OTHERS THEN
        v_user := NULL;
    END;
    IF NOT EXISTS (SELECT 1 FROM public.users u WHERE u.id = v_user AND u.tenant_id = NEW.tenant_id AND u.role = 'tenant_admin' AND u.is_active) THEN
        RAISE EXCEPTION USING
            MESSAGE = 'field approval: only a supervisor of the order''s own utility (its tenant_admin, Tally staff through its Tally User) approves a disconnect on a mismatch or without evidence (D9-1) [F3a] (v5.4.2-26)',
            ERRCODE = 'insufficient_privilege';
    END IF;
    SELECT * INTO o FROM public.service_orders x WHERE x.id = NEW.service_order_id;
    IF FOUND AND o.order_type <> 'disconnect' THEN
        RAISE EXCEPTION USING
            MESSAGE = format('field approval: order %s is a %s, not a disconnect [F3b] (v5.4.2-26)', o.order_number, o.order_type),
            ERRCODE = 'check_violation';
    END IF;
    IF NEW.kind = 'meter_mismatch' THEN
        SELECT * INTO v FROM public.service_order_field_visits x WHERE x.id = NEW.visit_id;
        IF NOT FOUND OR v.service_order_id IS DISTINCT FROM NEW.service_order_id OR v.outcome <> 'aborted' OR v.matched
           OR NOT coalesce(NEW.evidence_ref ~ '[[:alnum:]]', false) THEN
            RAISE EXCEPTION USING
                MESSAGE = format('field approval: a mismatch approval names the aborted, unmatched visit of order %s whose mismatch it approves, and an evidence reference (R-38) [F3b] (v5.4.2-26)', o.order_number),
                ERRCODE = 'check_violation';
        END IF;
    ELSIF NEW.visit_id IS NOT NULL THEN
        RAISE EXCEPTION USING
            MESSAGE = 'field approval: a no-evidence approval names no visit [F3b] (v5.4.2-26)',
            ERRCODE = 'check_violation';
    END IF;
    NEW.approved_by := v_user;
    RETURN NEW;
END;
$$;
COMMENT ON FUNCTION public.enforce_field_approval() IS
    'v5.4.2-26 (F3). BEFORE INSERT on service_order_field_approvals: the session''s user (app.user_id) is an active tenant_admin of the order''s own utility [F3a] — a platform administrator acts through the utility''s Tally User (Ryan 2026-11-07), never as themselves; the order is a disconnect; a mismatch approval names the aborted, unmatched visit of its order and an evidence reference; a no-evidence approval names no visit [F3b]. Stamps approved_by from the session (the caller''s value is overwritten).';
REVOKE ALL ON FUNCTION public.enforce_field_approval() FROM PUBLIC, tally_app, tally_core;
CREATE TRIGGER b_enforce_field_approval BEFORE INSERT ON public.service_order_field_approvals FOR EACH ROW EXECUTE FUNCTION public.enforce_field_approval();
#!/usr/bin/env python3
"""v5.4.2-26 — fill assert_collections_guard_invariants()'s lists from the catalogue.

Applies the patch, with its lists emptied, to a fresh clone of BASE (default
ci_pre26: -25 applied, -26 not), reads back the catalogue's own text of every
object -26 builds, and writes it into the patch between each list's markers:

    ARRAY[ -- @@TRIGGERS@@ <entries> ]   (likewise CONSTRAINTS, INDEXES, TABLES, FUNCS)

Run after any change to a pinned object, then the battery, mutations and ci.sh.

    python3 tests/v5.4.2-26/fill-manifest.py [BASE]
"""
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
PATCH = ROOT / "sql/v5.4.2-26-collections-decisions.sql"
BASE = sys.argv[1] if len(sys.argv) > 1 else "ci_pre26"
DB = "fill26"
LISTS = ["TRIGGERS", "CONSTRAINTS", "INDEXES", "TABLES", "FUNCS"]

NEW_TABLES = ["collections_conditions", "collections_decisions", "service_order_field_visits", "service_order_field_approvals"]
TRIGGERS_ON_OLD = ["b_enforce_dunning_event", "z_dunning_move_stage", "a_enforce_dunning_stage_projection",
                   "a_enforce_adhoc_charge_decision", "a_enforce_late_fee_line", "a_enforce_disconnect_order",
                   "a_enforce_do_not_disconnect_projection", "enrollment_recompute_dnd"]
CONSTRAINTS_ON_OLD = ["dunning_events_invoice_id_fkey", "dunning_events_decision_fkey", "adhoc_charges_decision_fkey",
                      "service_orders_decision_fkey"]
UNIQUE_INDEXES = ["dunning_events_one_per_decision", "adhoc_charges_one_per_decision", "service_orders_one_per_decision",
                  "service_order_field_visits_one_executed", "service_order_field_visits_one_per_decision"]


def psql(db: str, sql: str, *, stdin: str | None = None, opts: str | None = None) -> str:
    cmd = ["docker", "exec", "-i"]
    if opts:
        cmd += ["-e", f"PGOPTIONS={opts}"]
    cmd += ["tally-pg", "psql", "-U", "tally", "-d", db, "-v", "ON_ERROR_STOP=1", "-qAt"]
    if sql:
        cmd += ["-c", sql]
    r = subprocess.run(cmd, input=stdin, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"psql failed on {db}: {r.stderr.strip()}")
    return r.stdout


def emptied(text: str) -> str:
    for name in LISTS:
        text, n = re.subn(r"ARRAY\[\n\s*-- @@%s@@\n.*?\s*\];" % name, "'{}'::text[];", text, flags=re.S)
        assert n == 1, f"list {name} not found once"
    return text


def lit(s: str) -> str:
    return "'" + s.replace("'", "''") + "'"


def main() -> None:
    text = PATCH.read_text()
    psql("postgres", f"DROP DATABASE IF EXISTS {DB}")
    psql("postgres", f"CREATE DATABASE {DB} TEMPLATE {BASE}")
    psql(DB, f"REVOKE TEMP ON DATABASE {DB} FROM PUBLIC, tally_app, tally_core")
    psql(DB, "", stdin=emptied(text), opts="-c search_path= -c check_function_bodies=on")
    arr = lambda xs: "ARRAY[" + ",".join(lit(x) for x in xs) + "]"
    funcs = re.findall(r"CREATE OR REPLACE FUNCTION public\.(\w+)\(", text)
    funcs = sorted(set(f for f in funcs if f != "assert_collections_guard_invariants"))
    q = {
        "TRIGGERS": f"""SELECT pg_get_triggerdef(t.oid) FROM pg_trigger t JOIN pg_class c ON c.oid = t.tgrelid
                         WHERE NOT t.tgisinternal AND c.relnamespace = 'public'::regnamespace
                           AND (c.relname = ANY ({arr(NEW_TABLES)}) OR t.tgname = ANY ({arr(TRIGGERS_ON_OLD)}))
                         ORDER BY 1""",
        "CONSTRAINTS": f"""SELECT k.conrelid::regclass::text || ' ' || k.conname || ' ' || pg_get_constraintdef(k.oid)
                            FROM pg_constraint k JOIN pg_class c ON c.oid = k.conrelid
                           WHERE c.relnamespace = 'public'::regnamespace
                             AND (c.relname = ANY ({arr(NEW_TABLES)}) OR k.conname = ANY ({arr(CONSTRAINTS_ON_OLD)}))
                           ORDER BY 1""",
        "INDEXES": f"""SELECT indexdef FROM pg_indexes WHERE schemaname = 'public' AND indexname = ANY ({arr(UNIQUE_INDEXES)}) ORDER BY 1""",
        "TABLES": f"""SELECT c.relname || ' | ' || coalesce(c.relacl::text, '-') || ' | ' || c.relrowsecurity::text || ' | ' || c.relforcerowsecurity::text
                       FROM pg_class c WHERE c.relnamespace = 'public'::regnamespace AND c.relname = ANY ({arr(NEW_TABLES + ['collections_record_seq'])})
                      ORDER BY 1""",
        "FUNCS": f"""SELECT p.oid::regprocedure::text || ' | ' || p.prosecdef::text || ' | ' || coalesce(array_to_string(p.proconfig, ';'), '-')
                            || ' | ' || coalesce(p.proacl::text, '-') || ' | ' || md5(p.prosrc)
                       FROM pg_proc p WHERE p.pronamespace = 'public'::regnamespace AND p.proname = ANY ({arr(funcs)})
                      ORDER BY 1""",
    }
    for name in LISTS:
        rows = [r for r in psql(DB, q[name]).split("\n") if r]
        if name == "FUNCS":
            missing = set(funcs) - {r.split("(")[0] for r in rows}
            assert not missing, f"functions not found: {missing}"
        body = ",\n".join("        " + lit(r) for r in rows)
        text, n = re.subn(r"(ARRAY\[\n\s*-- @@%s@@\n).*?\s*\];" % name,
                          lambda m: m.group(1) + body + "\n    ];", text, flags=re.S)
        assert n == 1, name
        print(f"{name}: {len(rows)}")
    PATCH.write_text(text)
    psql("postgres", f"DROP DATABASE {DB}")


if __name__ == "__main__":
    main()

exec
/bin/zsh -lc "cat tests/v5.4.2-26/review/codex-r1.md | tail -75; sed -n '1,210p' tests/v5.4.2-26/review/battery-26-frozen-r2.sql; rg -n 'AGENTS.md' .gitignore; rg -n 'CREATE.*service_orders|service_orders.*TRIGGER|ON public.service_orders|INSERT INTO public.invoice_line_items|GRANT.*invoice_line_items|recompute_do_not_disconnect' sql/tu.sql; rg -n 'R-12|Tally User|2026-11-22|2026-11-25' application/DECISION-LOG.md; rg --files /Users/ryanscomputer/code/gas-billing-memory/application | rg 'CCK|ruling|decision|d9|d3' " in /Users/ryanscomputer/code/tally-utility
 succeeded in 0ms:
**Evidence:** patch 762 reads `invoices.dunning_stage` in the BEFORE ROW trigger; 777 copies it into the event. The projection is updated only by the AFTER ROW trigger, 790–805. The row lock serializes different transactions, but does not make a queued AFTER trigger run before the next BEFORE ROW invocation in the same INSERT.

Insert a reminder and then a payment-plan event for one current bill in a single VALUES statement. Both BEFORE invocations are predicted to record `previous_stage = current`; the second should record `reminder_sent`. The final invoice projection can still look correct, so checking only the invoice misses the immutable history corruption. This is the exact class covered by PATCH-LESSONS `projection-checks-lag-in-one-statement`.

**Probe:** [02-stage-statements.sql](codex-r1-probes/02-stage-statements.sql). It prints both events and the projection, and separately exercises a dependent writable CTE. The CTE's actual outcome should be read from the output, not inferred from textual statement order.

**Required correction:** derive the predecessor from authoritative ordered events, or serialize the stage/history update in a way that is correct within a statement. Measure the proposed fix with VALUES, INSERT SELECT, writable CTE and multi-row COPY; do not fix this by trusting caller-supplied stages. The frozen E2 checks use separate statements; CR6 tests separate sessions and cannot cover this case.

## B3 — predicted: status updates are not pinned against stale execution snapshots

**Evidence:** patch 918 reads whether an execution exists. Only paths that call `collections_subject_lock` enforce READ COMMITTED. The order UPDATE branch never calls it or independently checks isolation. A visit takes `FOR SHARE` on the order (987), but does not update its row version.

Predicted schedule: A starts REPEATABLE READ and establishes a snapshot of an open order. B, at READ COMMITTED, records its executed visit and commits. A cancels the order. A's execution lookup sees its old snapshot; B's share lock did not create an updated order tuple that would force a serialization failure. The result can be an executed order marked cancelled, contrary to F4d. A READ COMMITTED-only execution path is insufficient when the competing status writer is unrestricted. SERIALIZABLE mixed with a READ COMMITTED execution writer is not a blanket cure either.

**Probe/evidence recipe:** [06-lock-and-isolation-inspection.sql](codex-r1-probes/06-lock-and-isolation-inspection.sql) prints the actual functions/triggers and tests the subject helper's isolation rejection. Its header gives the precise concurrent schedule for the author's harness. **Limitation:** this is not an executable two-session reproduction; the race remains unmeasured. Confirm it before accepting a specific fix, but the unrestricted stale read is visible in source.

**Required correction:** pin the relevant order status writes to READ COMMITTED too, or use a shared row-version protocol for execution and status transitions. Add old-snapshot cancellation tests, not just CR8/CR8b at their default isolation. Do not acquire the advisory lock after already taking the order update lock without revisiting lock order.

## S1 — predicted: surplus approval links escape order/kind checks

**Evidence:** patch 1017–1038 validates `mismatch_approval_id` only when the visit mismatches; 1039–1054 validates `no_evidence_approval_id` only when evidence is empty. A matched visit with evidence can name another order's no-evidence approval in *both* fields. The tenant-only FKs accept the links; the guard never checks them. Consequently the assertion that each approval belongs to the executing order and is used once is broader than the implementation.

This does not let an unmatched/no-photo visit proceed without its required approval: those branches still check. It does corrupt the audit linkage and allows an approval to be cited on unrelated executions.

**Probe:** 01, `S1 wrong-order/wrong-kind surplus approval`, followed by the order/kind readback. Validate every non-NULL approval reference, whether needed or surplus; alternatively refuse surplus references explicitly.

## S2 — predicted: new actor links and platform approval retain the pre-November model

**Evidence:** patch 267, 596 and 625 add single-column user FKs for decision creator, visit creator and approver. The new RLS policies admit platform administrators across tenants; `enforce_field_approval` uses the existing `session_is_supervisor`, which returns true for a platform administrator without an impersonation record.

**Probe:** [04-tenancy-and-catalog.sql](codex-r1-probes/04-tenancy-and-catalog.sql) prints the constraints and attempts a T2 platform user's approval/decision on T1 records. Expected: accepted, with the stored actor belonging to T2.

This fits the October F3 design but not the November 5 R-12 ruling and November 7 Tally User ruling. DECISION-LOG explicitly says that the shared impersonation machinery is not built and assigns the broad FK sweep later; this is a known cross-cutting dependency, not evidence that an ordinary operator can promote itself. Nevertheless, the patch cannot be described as fully implementing the newer rulings. Tie the new actor links to tenant and reconcile supervisor authorization with that shared work, or explicitly carry a tracked release dependency. Do not silently add these three links to the old untied backlog.

## S3 — executed: race mutation classification accepts infrastructure failures

**Evidence:** frozen race `verdict()` prints the same `FAIL CRn` prefix for a failed session A, no observed lock wait, an unrelated B failure, and actual invariant damage. Frozen mutation runner's final classification accepts the first line matching `FAIL <named check>[:\s]`, without validating the reason.

I evaluated only that regex against literal strings, without importing or running either runner. These all classified as caught:

- `FAIL CR1: session A itself failed: connection lost`
- `FAIL CR1: session B was never seen waiting on a lock`
- `FAIL CR2: expected B refused with [A4], got: statement timeout`

Thus the 127/127 result does not by itself prove every race mutation failed for its intended reason. I am **not** asserting that any particular historical run encountered these failures. Distinguish BROKEN and SEQUENTIAL from detected damage, and self-test the classifier with literal outputs as PATCH-LESSONS requires.

## S4 — predicted: history-load projection contract is incomplete

**Evidence:** the patch makes the customer projection fence ALWAYS, but does not change the ordinary `enrollment_recompute_dnd` trigger in `tu.sql:11879`. In replica mode, loading an active protective enrollment is predicted to leave the customer flag false because its recompute trigger does not run. A subsequent direct repair is barred by E4. The -24/-25 enrollment refusal triggers being ALWAYS does not make the recompute ALWAYS.

**Probe:** [03-repeat-fees-and-fences.sql](codex-r1-probes/03-repeat-fees-and-fences.sql), owner replica enrollment and expected-versus-actual flag. This is a history-loader limitation, not an application privilege bypass. Make the recomputation run on the supported load path, or specify and test a supported transactional reconciliation procedure. R5's no-TEMP assumption does not answer this case.

## N2 — predicted: recurring late fees fit; the stage moves backwards by design

**Probe:** 03 creates three decisions on different dates, three fees on the same bill and their three log events, with a payment-plan event between the first and second fees. Expected: all three fees are recorded; the second log moves `payment_plan` back to `late_fee_assessed`. Uniqueness is per decision, not per bill. The projection is the latest stage-moving event's mapping, not a monotone collections progression.

This satisfies the November 22 ability to penalize the same unpaid principal monthly. It does not decide whether the city permits recurrence, compute the per-line penalty base, or exclude earlier penalties: those remain the core/rule layer's responsibilities. Preserve that distinction in the application contract, and add this recurring-fee case so a later consumer does not mistake stage for highest stage reached. I found no executable mirrored SQL read of the dropped invoice fee columns; 04 also searches installed function bodies. Mentions of the stage value `late_fee_assessed` and old descriptive comments are not dependencies on the removed column.

## N3 — predicted: broader design, earlier patches and residual assessment

**Probes:** 03, 04, [05-gates-and-earlier-writer.sql](codex-r1-probes/05-gates-and-earlier-writer.sql), and 06 support the following bounded conclusions. They do not substitute for the author's complete regression suite.

- The vocabulary and outcome-shape guards express fail-toward-protection: a recorded unevaluable result cannot authorize an act. Probe 05 exercises no-decision, blocked, unevaluable, expired, other-bill, superseded and eligible late-fee cases, plus two first decisions in one INSERT. The shared act checker serves the other act paths; the frozen battery covers their individual mappings, but it is not a full cross-product of every act and refusal.
- `dispute`, `agency_pledge`, `aged_suspense` and `non_disconnectable_debt` are vocabulary, not evaluations. -26 does not call the -25 shelter readers or -24 pledge/suspense readers to compute the decision. That follows C3/R4, rather than proving the newer business rules are enforced in SQL. The core must use amount/line shelter, the silent-city default's three blocked acts (not notices), current pledge/suspense data, the gas-first partial-payment order, and the meter-error non-disconnectable amount. The cut-off settings remain onboarding requirements; an inability to evaluate stays blocking. AC-47's one recorded run instant belongs in this core contract as well.
- The consolidated-notice NULL branch is **not a finding**: design C3 says “when the bill names one,” and frozen C3d2 expressly allows another customer-owned location. Probe 01 preserves this positive case. The brief/header shorthand is narrower than the actual design.
- The -26 late-fee UPDATE branch relies on -23's fixed charge identity for type and effective date. Probe 03 checks those edits rather than treating the early return as a standalone bypass. The two retired enrollment checks remain separate from the DND recompute; 03 exercises the protective and retired paths.
- No new permission regression in an earlier owner path was established by source inspection. The new invoice/customer projection triggers inspect NEW/OLD without reading the new tables, and the charge UPDATE branch does not call the collections helper. Probe 04 inventories all six named roles, attempts direct projection writes, and runs installed zero-argument invariant functions, including the -24/-25 invariants omitted from -26's final block. Probe 05 exercises `void_invoice` through its definer. These probes are pending, so this is **not** a certification that all -23/-24/-25 properties still hold.
- Subject advisory locks precede the explicit invoice/order row locks in the principal decision/act paths. Multi-subject statements can acquire multiple locks and require the documented 40P01 retry. B3 is a separate snapshot problem. Location ownership and meter-deployment reads do not participate in that mutex; a catalog inspection alone cannot certify their concurrent freshness. No deployment-change race was executed or claimed here.
- **R1:** UTC dating is an explicit convention, not a newly discovered blocker. **R2:** deferred typed rule citations are accepted design scope; inputs/fingerprint still need meaningful core content. **R3:** reconnection/broken-plan no-move behavior is explicitly designed and covered by frozen E2. **R4:** evaluation remains core-owned; the patch is not an autonomous collections engine. **R5:** no demonstrated ordinary app depth bypass under revoked TEMP/CREATE; it is conditional, not a role-independent proof that only a particular trigger can write. S4 is an uncovered load path, and B2 is a statement-shape failure outside that assumption. None of R1–R5 excuses B1–B3.

## N4 — executed source review: migration and test coverage limits

The migration source names an offending row for each of its six stop conditions and wraps the changes in one transaction. Its marker is existence of `collections_decisions`, not a schema/version validation. P1 compares object counts; that is weaker than proving all definitions and contents unchanged. P4 sets both old fee columns together and does not isolate their individual predicates. The migration does not establish a go-live collections-rule configuration, consistently with the November 25 onboarding decision. No migration result was executed or independently affirmed here; this is a statement about the reviewed source and the author's reported results.

Missing regression cases that matter for this round: the B1 transfer/customer mismatch, B2 VALUES/CTE/COPY history, B3 old-snapshot cancellation, S1 surplus approvals, S2 foreign-tenant actor stamps/platform session, S4 replica recompute, and N2 second/third monthly fees. The frozen battery's H checks cover a subset of invariants and never exercise the earlier owner-role operations. Add the affected probes to the normal tests after the author measures their outcomes, then validate fixes and re-run the relevant invariants/earlier-writer batteries. Keep actual infrastructure failures separate from evidence that a mutation damaged the intended rule.
