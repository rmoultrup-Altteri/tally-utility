# Retain the frozen assertions; add full diagnostics to every caught helper error.
b=b.replace('EXCEPTION WHEN OTHERS THEN\\n', \"EXCEPTION WHEN OTHERS THEN\\n    RAISE NOTICE 'caught SQLSTATE=% message=%', SQLSTATE, SQLERRM;\\n\")
