observe=\"\"\"
CREATE FUNCTION pg_temp.observe(label text, stmt text) RETURNS boolean LANGUAGE plpgsql AS "'$$
BEGIN
  EXECUTE stmt;
  RAISE NOTICE '"'%: ACCEPTED SQLSTATE=00000', label;
  RETURN true;
EXCEPTION WHEN OTHERS THEN
  RAISE NOTICE '%: REFUSED SQLSTATE=% message=%', label, SQLSTATE, SQLERRM;
  RETURN false;
END "'$$;
GRANT EXECUTE ON FUNCTION pg_temp.observe(text,text) TO tally_app;
"""
(out/'"'02-order-timestamps.sql').write_text(prefix+observe+\"\"\"
-- S1: the order timestamp is caller-controlled. The decision's stamp stays intact.
SET ROLE tally_app;
SELECT pg_temp.as_user('b1');
SELECT pg_temp.admits('setup order decision', pg_temp.dec('TSO', 'disconnect_order', 'c1', NULL, 'd1', 'e1', pg_temp.today(), 'eligible', NULL, NULL, NULL, pg_temp.today(), NULL, 'tso'));
SELECT pg_temp.admits('setup execute decision', pg_temp.dec('TSX', 'disconnect_execute', 'c1', NULL, 'd1', 'e1', pg_temp.today(), 'eligible', NULL, NULL, NULL, pg_temp.today(), NULL, 'tsx'));
-- Supply an explicit order creation coordinate later than the proposed arrival.
SELECT pg_temp.observe('caller supplies created_at on INSERT', format("'$q$
 INSERT INTO public.service_orders(id,tenant_id,order_number,order_type,description,customer_id,location_id,meter_id,collections_decision_id,created_at)
 VALUES (%L,%L,'"'B26-TS','disconnect','timestamp probe',%L,%L,%L,%L,now()+interval '1 hour')
"'$q$,pg_temp.id('"'TS'),pg_temp.u('a1'),pg_temp.u('c1'),pg_temp.u('d1'),pg_temp.u('e1'),pg_temp.id('TSO')));
SELECT pg_temp.observe('control: arrival precedes order but equals decision (expect F2f)',
 pg_temp.visit('TSV','TS',now(),'SN-E1','L1','executed',NULL,'TSX',NULL,NULL,'{photo-ts}'));
SELECT pg_temp.observe('caller lowers the order bound',format('UPDATE public.service_orders SET created_at=now() WHERE id=%L',pg_temp.id('TS')));
SELECT pg_temp.observe('same arrival after lowering bound (predict accepted)',
 pg_temp.visit('TSV','TS',now(),'SN-E1','L1','executed',NULL,'TSX',NULL,NULL,'{photo-ts}'));
SELECT pg_temp.observe('caller raises creation time after execution (predict accepted)',format('UPDATE public.service_orders SET created_at=now()+interval ''1 hour'' WHERE id=%L',pg_temp.id('TS')));
SELECT o.created_at AS order_created, d.created_at AS decision_created, v.arrived_at,
       v.arrived_at < o.created_at AS execution_now_precedes_order
FROM public.service_orders o JOIN public.service_order_field_visits v ON v.service_order_id=o.id
JOIN public.collections_decisions d ON d.id=v.collections_decision_id WHERE o.id=pg_temp.id('TS');
RESET ROLE;
ROLLBACK;
\"\"\")
(out/'03-manifest-drift.sql').write_text(header+\"\"\"
BEGIN;
-- S3: each edit is isolated and undone, including when the invariant misses it.
CREATE FUNCTION pg_temp.drift(label text, stmt text) RETURNS void LANGUAGE plpgsql AS "'$$
BEGIN
  BEGIN
    EXECUTE stmt;
    PERFORM public.assert_collections_guard_invariants();
    RAISE NOTICE '"'%: invariant ACCEPTED drift SQLSTATE=00000', label;
    RAISE EXCEPTION 'intentional undo of drift' USING ERRCODE='P0098';
  EXCEPTION WHEN OTHERS THEN
    RAISE NOTICE '%: SQLSTATE=% message=%', label, SQLSTATE, SQLERRM;
  END;
END "'$$;
SELECT public.assert_collections_guard_invariants();
SELECT pg_temp.drift('"'control: disabled guard', 'ALTER TABLE public.service_order_field_visits DISABLE TRIGGER b_enforce_field_visit');
SELECT pg_temp.drift('policy becomes allow-all', 'ALTER POLICY tenant_isolation ON public.collections_decisions USING (true) WITH CHECK (true)');
SELECT pg_temp.drift('evidence array loses NOT NULL', 'ALTER TABLE public.service_order_field_visits ALTER COLUMN evidence_refs DROP NOT NULL');
SELECT pg_temp.drift('column grant not table grant', 'GRANT SELECT (inputs) ON public.collections_decisions TO PUBLIC');
SELECT pg_temp.drift('helper volatility changes', 'ALTER FUNCTION public.collections_live_decision(uuid,text,uuid,uuid,uuid,uuid) VOLATILE');
SELECT public.assert_collections_guard_invariants();
ROLLBACK;
\"\"\")
(out/'04-additional-boundaries.sql').write_text(prefix+observe+\"\"\"
-- A10 coverage absent from the frozen r2 battery: broad notice over a meter block;
-- execution under a meter decision while the whole location is blocked.
SET ROLE tally_app;
SELECT pg_temp.as_user('b1');
SELECT pg_temp.admits('setup broad eligible notice',pg_temp.dec('NB','notice','c1','01','d1',NULL,pg_temp.today(),'eligible',NULL,NULL,NULL,pg_temp.today(),NULL,'nb'));
SELECT pg_temp.admits('setup meter blocked notice',pg_temp.dec('NM','notice','c1','01','d1','e1',pg_temp.today(),'blocked','{medical_hold}',NULL,'medical_hold',NULL,NULL,'nm'));
SELECT pg_temp.observe('broad notice must honor meter block (A10)',pg_temp.ev('NE','01','c1','shutoff_notice_sent',now(),'NB'));
SELECT pg_temp.admits('setup order decision',pg_temp.dec('AO','disconnect_order','c1',NULL,'d1','e1',pg_temp.today(),'eligible',NULL,NULL,NULL,pg_temp.today(),NULL,'ao'));
SELECT pg_temp.admits('setup order',pg_temp.so('ASO','c1','d1','e1','AO'));
SELECT pg_temp.admits('setup eligible meter execution',pg_temp.dec('AX','disconnect_execute','c1',NULL,'d1','e1',pg_temp.today(),'eligible',NULL,NULL,NULL,pg_temp.today(),NULL,'ax'));
SELECT pg_temp.admits('setup blocked broad execution',pg_temp.dec('AB','disconnect_execute','c1',NULL,'d1',NULL,pg_temp.today(),'blocked','{medical_hold}',NULL,'medical_hold',NULL,NULL,'ab'));
SELECT pg_temp.observe('execution must honor broad block (A10)',pg_temp.visit('AV','ASO',now(),'SN-E1','L1','executed',NULL,'AX',NULL,NULL,'{photo-a}'));
SELECT s, e, public.collections_dunning_stage(e,s) AS resulting_stage
FROM unnest(ARRAY['payment_plan','resolved','written_off','collections']) s
CROSS JOIN unnest(ARRAY['reminder_sent','late_fee_applied','shutoff_notice_sent','reconnected','payment_plan_broken']) e;
-- Two dependent writable statements, rather than one INSERT merely wrapped in WITH.
WITH a AS (
 INSERT INTO public.dunning_events(tenant_id,invoice_id,customer_id,event_type,event_date)
 VALUES(pg_temp.u('a1'),pg_temp.u('01'),pg_temp.u('c1'),'reminder_sent',now()) RETURNING id
)
INSERT INTO public.dunning_events(tenant_id,invoice_id,customer_id,event_type,event_date)
SELECT pg_temp.u('a1'),pg_temp.u('01'),pg_temp.u('c1'),'payment_plan_created',now() FROM a;
SELECT event_type, previous_stage, new_stage, record_seq FROM public.dunning_events WHERE invoice_id=pg_temp.u('01') ORDER BY record_seq;
SELECT dunning_stage FROM public.invoices WHERE id=pg_temp.u('01');
RESET ROLE;
ROLLBACK;
