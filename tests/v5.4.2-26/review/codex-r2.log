b=b.replace(\"EXCEPTION WHEN SQLSTATE 'P0098' THEN\\n\", \"EXCEPTION WHEN SQLSTATE 'P0098' THEN\\n    RAISE NOTICE 'intentional undo SQLSTATE=% message=%', SQLSTATE, SQLERRM;\\n\")
header=\"-- Codex r2: NOT EXECUTED. Owner session, fresh clone with frozen r2 strictly applied.\\n-- Revoke TEMP from PUBLIC/tally_app/tally_core when preparing the clone.\\n-- Fixtures are frozen-battery fixtures. No role creation or alteration.\\n\\\\set ON_ERROR_STOP on\\n\\\\set VERBOSITY verbose\\n\"
