CREATE FUNCTION pg_temp.observe(label text, stmt text) RETURNS boolean LANGUAGE plpgsql AS $$
BEGIN
  EXECUTE stmt;
  RAISE NOTICE '%: ACCEPTED SQLSTATE=00000', label;
  RETURN true;
EXCEPTION WHEN OTHERS THEN
  RAISE NOTICE '%: REFUSED SQLSTATE=% message=%', label, SQLSTATE, SQLERRM;
  RETURN false;
END $$;
GRANT EXECUTE ON FUNCTION pg_temp.observe(text,text) TO tally_app;

-- S1: the order timestamp is caller-controlled. The decision's stamp stays intact.
