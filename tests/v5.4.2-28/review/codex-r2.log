CREATE FUNCTION pg_temp.attempt(label text, statement text) RETURNS boolean
LANGUAGE plpgsql AS $$
BEGIN
  EXECUTE statement;
  RAISE NOTICE '%: accepted (SQLSTATE 00000)', label;
  RETURN true;
EXCEPTION WHEN OTHERS THEN
  RAISE NOTICE '%: SQLSTATE=% MESSAGE=%', label, SQLSTATE, SQLERRM;
  RETURN false;
END $$;
