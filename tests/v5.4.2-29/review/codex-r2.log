755-CREATE FUNCTION public.should_charge_tax(p_customer_id uuid, p_item_is_taxable boolean, p_service_type text DEFAULT NULL::text, p_as_of_date date DEFAULT CURRENT_DATE) RETURNS boolean
756-    LANGUAGE plpgsql STABLE SECURITY DEFINER
757-    AS $$
758-DECLARE
759-    v_has_exemption BOOLEAN;
760-BEGIN
761-    -- Rule 1: item-level non-taxable wins
762-    IF p_item_is_taxable IS NULL OR p_item_is_taxable = false THEN
763-        RETURN false;
764-    END IF;
765-
766-    -- Rule 2: customer-level exemption check
767-    -- An exemption applies if it's active, in effect, and covers the service_type.
768-    -- service_type match: exemption applies to all services (NULL/empty array)
769-    -- OR the specific service_type is listed.
770-    SELECT EXISTS (
771-        SELECT 1
772-        FROM customer_tax_exemptions cte
773-        WHERE cte.customer_id = p_customer_id
774-          AND cte.status = 'active'
