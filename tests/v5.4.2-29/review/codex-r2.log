27021:CREATE OR REPLACE FUNCTION public.premise_places_as_of(p_service_location_id uuid, p_on date, p_axis text)
27022-    RETURNS TABLE (place_id uuid, kind_code text, state_code text, place_code text, name text, specificity integer, relation text, distance_miles numeric)
27023-    LANGUAGE plpgsql STABLE
27024-    SET search_path = public, pg_temp
27025-    AS $$
27026-DECLARE
27027-    v_state text;
27028-    v_state_place uuid;
27029-BEGIN
27030-    IF p_on IS NULL OR p_axis IS NULL OR p_axis <> ALL (ARRAY['regulatory', 'tax']) THEN
27031-        RAISE EXCEPTION USING
27032-            MESSAGE = format('premise_places_as_of: a date and an axis (regulatory or tax) are required; got %s, %s (v5.4.2-16)', coalesce(p_on::text, 'NULL'), coalesce(p_axis, 'NULL')),
27033-            ERRCODE = 'invalid_parameter_value';
27034-    END IF;
27035-    -- An invisible or missing premise has no state, so the state check
27036-    -- below refuses it too (review r2: one refusal, not two).
27037-    SELECT upper(btrim(l.state)) INTO v_state FROM public.service_locations l WHERE l.id = p_service_location_id;
27038-    SELECT p.id INTO v_state_place FROM public.places p
27039-     WHERE p.kind_code = 'state' AND p.state_code = v_state AND daterange(p.effective_from, p.effective_to, '[)') @> p_on;
27040-    IF v_state_place IS NULL THEN
27041-        RAISE EXCEPTION USING
27042-            MESSAGE = format('premise_places_as_of: premise %s is not found (or not visible), or its state %s is no state known on %s; its places cannot be read (v5.4.2-16)', p_service_location_id, coalesce(v_state, 'NULL'), p_on),
27043-            ERRCODE = 'no_data_found';
27044-    END IF;
27045-    RETURN QUERY
27046-    SELECT p.id, p.kind_code, p.state_code, p.place_code, p.name, k.specificity, m.relation, m.distance_miles
27047-      FROM public.premise_place_memberships m
27048-      JOIN public.places p ON p.id = m.place_id
27049-      JOIN public.place_kinds k ON k.kind_code = p.kind_code
27050-     WHERE m.service_location_id = p_service_location_id AND m.axis = p_axis AND m.voided_at IS NULL
27051-       AND daterange(m.valid_from, m.valid_to, '[)') @> p_on
27052-       -- defence in depth: the place in force on the date, of the premise's state
27053-       AND daterange(p.effective_from, p.effective_to, '[)') @> p_on
27054-       AND p.state_code = v_state
27055-    UNION ALL
27056-    SELECT p.id, p.kind_code, p.state_code, p.place_code, p.name, k.specificity, 'within'::text, NULL::numeric
27057-      FROM public.places p JOIN public.place_kinds k ON k.kind_code = p.kind_code
27058-     WHERE p.id = v_state_place;
27059-END;
