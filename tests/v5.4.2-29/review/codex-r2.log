#!/usr/bin/env bash
# Mutation run for v5.4.2-29: each mutation breaks one rule of the load and
# must be caught where it names:
#   a battery label (C1, Z2 …)   the mutated patch applies; battery-29 fails there
#   APPLY:<fragment>             the mutated patch itself refuses, naming it
#   RE:<case>                    reapply-29.sh, run on the mutated patch, fails that case
#   SRC:<case>                   source-check-29.sh fails that case
# A catch elsewhere fails the run. EXTRA: a JSON list of further [old, new]
# edits, each matching exactly once.
# The load has two layers: the in-loop comparison names the county that
# differs (diagnostic), and the postcondition is the guard. A mutation of the
# in-loop layer alone (N6-N8, N12) is caught by its message: the load still
# refuses, through the postcondition. N14-N15 remove a comparison from both
# layers, and the load is then admitted (r2; review r1, Opus S2).
#   tests/v5.4.2-29/mutations-29.sh [patch]    (uses m29 and r29re; one run at a time)
set -uo pipefail
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
P=${1:-$ROOT/sql/v5.4.2-29-texas-counties.sql}
B=$ROOT/tests/v5.4.2-29/battery-29.sql
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"; docker exec tally-pg psql -U tally -d postgres -qc "DROP DATABASE IF EXISTS m29" >/dev/null 2>&1' EXIT
docker cp "$B" tally-pg:/tmp/b29m.sql >/dev/null
fail=0; n=0; caught=0

mut() {  # $1 label, $2 expected, $3 old text (exactly once), $4 new text
  n=$((n + 1)); local exp=$2 got=""
  if ! python3 -c 'import sys, os, json
s = open(sys.argv[1]).read()
edits = [(sys.argv[2], sys.argv[3])] + [tuple(e) for e in json.loads(os.environ.get("EXTRA") or "[]")]
for o, w in edits:
    k = s.count(o)
    if k != 1: sys.exit("anchor matched %d times" % k)
    s = s.replace(o, w)
open(sys.argv[4], "w").write(s)' "$P" "$3" "$4" "$TMP/m.sql"; then
    echo "SETUP $1: anchor not found exactly once"; fail=1; return
  fi
  case $exp in
    RE:*)  got="RE:$(tests/v5.4.2-29/reapply-29.sh "$TMP/m.sql" 2>&1 | grep -m1 -o '^FAIL P[0-9]*' | cut -d' ' -f2)" ;;
    SRC:*) got="SRC:$(tests/v5.4.2-29/source-check-29.sh "$TMP/m.sql" 2>&1 | grep -m1 -o '^FAIL S[0-9a-z]*' | cut -d' ' -f2)" ;;
    *)
      docker exec tally-pg psql -U tally -d postgres -qc "DROP DATABASE IF EXISTS m29" -qc "CREATE DATABASE m29 TEMPLATE tally" >/dev/null 2>&1
      docker exec tally-pg psql -U tally -d m29 -qc "REVOKE TEMP ON DATABASE m29 FROM PUBLIC" -qc "REVOKE TEMP ON DATABASE m29 FROM tally_app" -qc "REVOKE TEMP ON DATABASE m29 FROM tally_core" >/dev/null
      docker cp "$TMP/m.sql" tally-pg:/tmp/m29.sql >/dev/null
      aout=$(docker exec -e PGOPTIONS="-c search_path= -c check_function_bodies=on" tally-pg psql -U tally -d m29 -v ON_ERROR_STOP=1 -q -o /dev/null -f /tmp/m29.sql 2>&1); ast=$?
      if [ $ast -ne 0 ]; then
        if [ "${exp#APPLY:}" != "$exp" ] && echo "$aout" | grep -q -- "${exp#APPLY:}"; then got=$exp
        else got="APPLY ($(echo "$aout" | grep -m1 ERROR | cut -c1-160))"; fi
      else
        bout=$(docker exec tally-pg psql -U tally -d m29 -v ON_ERROR_STOP=1 -q -o /dev/null -f /tmp/b29m.sql 2>&1); bst=$?
        got=$(echo "$bout" | grep -m1 -o "FAIL [A-Za-z0-9]*" | cut -d' ' -f2)
        [ -z "$got" ] && [ $bst -ne 0 ] && got="UNLABELLED ($(echo "$bout" | grep -m1 ERROR | cut -c1-160))"
      fi ;;
  esac
  if [ "$got" = "$exp" ]; then echo "caught $1 at $got"; caught=$((caught + 1))
  elif [ -z "$got" ] || [ "$got" = "RE:" ] || [ "$got" = "SRC:" ]; then echo "MISSED $1 (named $exp)"; fail=1
  else echo "WRONG CHECK $1: caught at $got, named $exp"; fail=1; fi
}

mut "N1 a county left out of the list" "APPLY:the list is not 254" \
  "    ('48505', 'Zapata County', 'America/Chicago'),
" ""
EXTRA='[["IF (SELECT count(*) FROM p29_counties) <> 254\n       OR", "IF false\n       OR"]]' \
mut "N2 a county left out, and the count check gone" C1 \
  "    ('48505', 'Zapata County', 'America/Chicago'),
" ""
mut "N2b a county left out: the source check" SRC:S2 \
  "    ('48505', 'Zapata County', 'America/Chicago'),
" ""
mut "N3 Culberson in Mountain time" "APPLY:Mountain exactly at 48141 and 48229" \
  "('48109', 'Culberson County', 'America/Chicago')" "('48109', 'Culberson County', 'America/Denver')"
EXTRA='[["IS DISTINCT FROM ARRAY['"'"'48141'"'"', '"'"'48229'"'"'] THEN", "IS DISTINCT FROM (SELECT array_agg(fips ORDER BY fips) FROM p29_counties WHERE zone = '"'"'America/Denver'"'"') THEN"]]' \
mut "N4 Culberson in Mountain time, and the list's zone check gone" C3 \
  "('48109', 'Culberson County', 'America/Chicago')" "('48109', 'Culberson County', 'America/Denver')"
mut "N5 a county misnamed" C1b \
  "('48201', 'Harris County'," "('48201', 'Haris County',"
mut "N5b a county misnamed: the source check" SRC:S2b \
  "('48201', 'Harris County'," "('48201', 'Haris County',"
mut "N6 a present county's name not compared" RE:P1 \
  "IF v_place.name IS DISTINCT FROM r.name OR v_zone" "IF false AND v_place.name IS DISTINCT FROM r.name OR v_zone"
mut "N7 a present county's zone not compared" RE:P2 \
  " OR v_zone IS DISTINCT FROM r.zone THEN" " THEN"
mut "N8 a present county's missing zone read as agreeing" RE:P3 \
  "OR v_zone IS DISTINCT FROM r.zone THEN" "OR coalesce(v_zone, r.zone) IS DISTINCT FROM r.zone THEN"
mut "N9 a county not on the list not refused" RE:P4 \
  "AND NOT EXISTS (SELECT 1 FROM p29_counties c WHERE c.fips = p.place_code)" "AND false"
mut "N10 the isolation check gone" RE:P5 \
  "IF current_setting('transaction_isolation') <> 'read committed' THEN" "IF false THEN"
mut "N11 a loaded county's zone dated from 1950" "APPLY:has no time_zone fact of America/Chicago in force on 1900-01-01" \
  "VALUES (v_place.id, 'time_zone', to_jsonb(r.zone), c_from," "VALUES (v_place.id, 'time_zone', to_jsonb(r.zone), DATE '1950-01-01',"
mut "N12 a present county skipped without a look (always CONTINUE)" RE:P1 \
  "        IF FOUND THEN
" "        IF FOUND THEN CONTINUE;
"
# every case fails under N13; the first is P1, because seeded El Paso (48141) is reloaded before Travis is reached
mut "N13 a present county reloaded rather than skipped" RE:P1 \
  "            CONTINUE;
        END IF;" "        END IF;"

# r2 (review r1, Opus S2; Opus S1, Fable S1)
EXTRA='[["AND p.name = c.name AND p.parent_place_id = v_tx)", "AND p.parent_place_id = v_tx)"]]' \
mut "N14 a county's name compared in neither layer" RE:P1 \
  "IF v_place.name IS DISTINCT FROM r.name OR v_zone" "IF false AND v_place.name IS DISTINCT FROM r.name OR v_zone"
EXTRA='[["AND f.value = to_jsonb(c.zone))", ")"]]' \
mut "N15 a county's zone compared in neither layer" RE:P2 \
  " OR v_zone IS DISTINCT FROM r.zone THEN" " THEN"
mut "N16 a present county looked up as open today (r1), not as of 1900" RE:P8 \
  "           AND daterange(p.effective_from, p.effective_to, '[)') @> c_from;
        IF FOUND THEN" "           AND p.effective_to IS NULL;
        IF FOUND THEN"
mut "N17 a code with rows but none on 1900-01-01 not refused by the load" RE:P9 \
  "        IF v_nrows > 0 THEN" "        IF false THEN"

echo "mutations-29: $caught of $n caught"
[ $fail -eq 0 ] && [ $caught -eq $n ]

exec
/bin/zsh -lc 'cat tests/v5.4.2-29/review/battery-29-frozen-r2.sql; cat tests/v5.4.2-29/review/older-tests-29-frozen-r1.diff; cat tests/v5.4.2-29/review/older-tests-29-r1-to-r2.diff' in /Users/ryanscomputer/code/tally-utility-rates
 succeeded in 0ms:
-- ============================================================================
-- BATTERY v5.4.2-29 — every Texas county and its time zone (2026-11-04; r2)
-- Run: psql -U tally -d <db-with-patch> -v ON_ERROR_STOP=1 -f battery-29.sql
-- One transaction, rolled back. Fixtures as the owner; the lookups the
-- application meets are run as tally_app. ok() treats NULL as a fail;
-- refuses_at() needs the SQLSTATE and a fragment of the guard's message.
--
--   C  the load: exactly the Census list (codes and names, by hash), each
--      county open, under Texas, in force from 1900, with one time_zone fact
--      in force across the whole range; Mountain exactly at El Paso and
--      Hudspeth; Culberson Central (the law, not local practice); the two
--      seeded rows kept, not duplicated; the citations; tally_app reads them
--      and cannot write them.
--   Z  what it changes: a premise in a county -16 never seeded (Harris,
--      Culberson) now has a zone; the state-agency fee check judges it
--      (admitted where the account was not yet a state agency at the end of
--      the period in Central time, refused where it was); a premise with no
--      county recorded is still refused (known limit L1).
--
-- The fixture's fact that matters (as in battery -28): customer C1 became a
-- state agency at 2026-07-01 05:30 UTC: 00:30 July 1 Central (after the end
-- of June 30), 23:30 June 30 Mountain (before it). C2 became one on
-- 2026-06-15, a state agency at the end of June in every zone.
-- ============================================================================
BEGIN;

CREATE FUNCTION pg_temp.refuses_at(p_label text, p_sql text, p_state text, p_guard text) RETURNS void
LANGUAGE plpgsql AS $$
DECLARE v_con text;
BEGIN
  BEGIN
    EXECUTE p_sql;
  EXCEPTION WHEN OTHERS THEN
    GET STACKED DIAGNOSTICS v_con = CONSTRAINT_NAME;
    IF SQLSTATE = p_state AND (v_con = p_guard OR strpos(SQLERRM, p_guard) > 0) THEN
      RAISE NOTICE 'PASS %: refused by % (%)', p_label, p_guard, left(SQLERRM, 140);
      RETURN;
    END IF;
    RAISE EXCEPTION 'FAIL %: refused with % [%] (%), expected % by %', p_label, SQLSTATE, v_con, SQLERRM, p_state, p_guard;
  END;
  RAISE EXCEPTION 'FAIL %: accepted', p_label;
END $$;
CREATE FUNCTION pg_temp.ok(p_label text, p_cond boolean) RETURNS void
LANGUAGE plpgsql AS $$
BEGIN
  IF p_cond IS DISTINCT FROM true THEN RAISE EXCEPTION 'FAIL %', p_label; END IF;
  RAISE NOTICE 'PASS %', p_label;
END $$;
CREATE FUNCTION pg_temp.admits(p_label text, p_sql text) RETURNS void
LANGUAGE plpgsql AS $$
BEGIN
  EXECUTE p_sql;
  RAISE NOTICE 'PASS %', p_label;
EXCEPTION WHEN OTHERS THEN
  RAISE EXCEPTION 'FAIL %: refused with % (%)', p_label, SQLSTATE, SQLERRM;
END $$;
-- zone_is(): the premise lookup answers p_zone; a refusal is a labelled FAIL.
CREATE FUNCTION pg_temp.zone_is(p_label text, p_loc uuid, p_zone text) RETURNS void
LANGUAGE plpgsql AS $$
DECLARE v text;
BEGIN
  BEGIN
    v := public.premise_time_zone_as_of(p_loc, DATE '2026-06-30');
  EXCEPTION WHEN OTHERS THEN
    RAISE EXCEPTION 'FAIL %: refused with % (%)', p_label, SQLSTATE, SQLERRM;
  END;
  IF v IS DISTINCT FROM p_zone THEN RAISE EXCEPTION 'FAIL %: % (expected %)', p_label, v, p_zone; END IF;
  RAISE NOTICE 'PASS %', p_label;
END $$;
GRANT EXECUTE ON FUNCTION pg_temp.refuses_at(text, text, text, text), pg_temp.ok(text, boolean), pg_temp.admits(text, text),
                          pg_temp.zone_is(text, uuid, text) TO tally_app;

-- ================================================================ C. the load
-- tx(): Texas's open counties.
CREATE TEMP VIEW tx_counties AS
  SELECT p.* FROM public.places p
   WHERE p.kind_code = 'county' AND p.state_code = 'TX' AND p.effective_to IS NULL;
GRANT SELECT ON tx_counties TO tally_app;

SELECT pg_temp.ok('C1 Texas has 254 open counties',
  (SELECT count(*) FROM tx_counties) = 254);
-- The hash of "code|name" lines in code order, computed from
-- application/places-sources/census-st48_tx_cou2020.txt (md5
-- e1ea7280eb41b680feb924b3bef2c411): the codes and names are the Census's.
SELECT pg_temp.ok('C1b the codes and names are exactly the Census list',
  (SELECT md5(string_agg(place_code || '|' || name, E'\n' ORDER BY place_code)) FROM tx_counties) = '5094ab8b28e6ad29990118f886535842');
SELECT pg_temp.ok('C1c every code is an odd number from 48001 to 48507',
  NOT EXISTS (SELECT 1 FROM tx_counties WHERE place_code !~ '^48[0-9]{3}$' OR substr(place_code, 3)::int % 2 = 0
                                            OR substr(place_code, 3)::int NOT BETWEEN 1 AND 507));
SELECT pg_temp.ok('C2 every county sits under Texas, in force from 1900-01-01',
  NOT EXISTS (SELECT 1 FROM tx_counties c
               WHERE c.effective_from <> DATE '1900-01-01'
                  OR c.parent_place_id IS DISTINCT FROM (SELECT id FROM public.places WHERE kind_code = 'state' AND place_code = 'TX' AND effective_to IS NULL)));
SELECT pg_temp.ok('C2b every county carries exactly one time_zone fact, open, from 1900-01-01',
  NOT EXISTS (SELECT 1 FROM tx_counties c
               WHERE (SELECT count(*) FROM public.place_facts f WHERE f.place_id = c.id AND f.fact_code = 'time_zone') <> 1
                  OR NOT EXISTS (SELECT 1 FROM public.place_facts f WHERE f.place_id = c.id AND f.fact_code = 'time_zone'
                                    AND f.effective_to IS NULL AND f.effective_from = DATE '1900-01-01')));
SELECT pg_temp.ok('C3 Mountain time exactly at El Paso (48141) and Hudspeth (48229)',
  (SELECT array_agg(c.place_code ORDER BY c.place_code) FROM tx_counties c
     JOIN public.place_facts f ON f.place_id = c.id AND f.fact_code = 'time_zone'
    WHERE f.value <> '"America/Chicago"') = ARRAY['48141', '48229']
  AND (SELECT bool_and(f.value = '"America/Denver"') FROM tx_counties c
         JOIN public.place_facts f ON f.place_id = c.id AND f.fact_code = 'time_zone'
        WHERE c.place_code IN ('48141', '48229')));
SELECT pg_temp.ok('C3b Culberson (48109), east of Hudspeth''s east line, is Central by law',
  (SELECT f.value FROM tx_counties c JOIN public.place_facts f ON f.place_id = c.id AND f.fact_code = 'time_zone'
    WHERE c.place_code = '48109') = '"America/Chicago"');
SELECT pg_temp.ok('C4 El Paso and Hudspeth are -16''s seeded rows, one each, unchanged',
  (SELECT count(*) FROM public.places WHERE kind_code = 'county' AND state_code = 'TX' AND place_code IN ('48141', '48229')) = 2
  AND (SELECT bool_and(source_note = 'Texas county (FIPS ' || place_code || ').') FROM tx_counties WHERE place_code IN ('48141', '48229')));
SELECT pg_temp.ok('C5 the 252 loaded counties cite the Census file, their (Central) facts 49 CFR 71.6(a) and 71.7(e)',
  (SELECT count(*) FROM tx_counties c
     JOIN public.place_facts f ON f.place_id = c.id AND f.fact_code = 'time_zone'
    WHERE strpos(c.source_note, 'st48_tx_cou2020.txt') > 0 AND strpos(c.source_note, c.place_code) > 0
      AND strpos(f.source_note, '49 CFR 71.6(a), 71.7(e)') > 0 AND f.value = '"America/Chicago"') = 252);

SET ROLE tally_app;
SELECT pg_temp.ok('C6 the application reads all 254 and their zones',
  (SELECT count(*) FROM tx_counties c JOIN public.place_facts f ON f.place_id = c.id AND f.fact_code = 'time_zone') = 254);
SELECT pg_temp.refuses_at('C6b the application cannot write a county',
  $q$INSERT INTO public.places (kind_code, state_code, place_code, name, parent_place_id, effective_from, source_note)
     SELECT 'county', 'TX', '48990', 'X', id, DATE '1900-01-01', 'x' FROM public.places WHERE kind_code = 'state' AND place_code = 'TX'$q$,
  '42501', 'permission denied');
SELECT pg_temp.refuses_at('C6c the application cannot close one',
  $q$UPDATE public.places SET effective_to = DATE '2026-01-01' WHERE kind_code = 'county' AND place_code = '48201'$q$,
  '42501', 'permission denied');
RESET ROLE;

