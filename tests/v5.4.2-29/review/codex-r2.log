27064-CREATE OR REPLACE FUNCTION public.premise_time_zone_as_of(p_service_location_id uuid, p_on date) RETURNS text
27065-    LANGUAGE plpgsql STABLE
27066-    SET search_path = public, pg_temp
27067-    AS $$
27068-DECLARE
27069-    v_tz text;
27070-    v_kind text;
27071-    v_uniform boolean;
27072-    v_zones text[];
27073-    v_unzoned text;
27074-BEGIN
27075-    -- Both axes place the premise (a county recorded for tax only still
27076-    -- counts — review r1 B3). Every place it is within whose kind can carry a
27077-    -- zone is a candidate, zone or none. The answering level is the most
27078-    -- specific one where some candidate carries a zone: a level where none
27079-    -- does falls through (a city with no zone answers by its county). At that
27080-    -- level every candidate must carry one, and all must agree: two counties
27081-    -- on two axes with different zones (review r2 N1), or one with a zone and
27082-    -- one without (r3: a partial load), are refused, not tie-broken. A more
27083-    -- specific zone outranks a less specific one by design: a city's zone
27084-    -- answers over its county's, and the refusals apply only at the
27085-    -- answering level (a county conflict under a zoned city is not read).
27086-    WITH cand AS (
27087-        SELECT DISTINCT pl.place_id, pl.kind_code, pl.specificity, pl.name, f.value #>> '{}' AS tz
27088-          FROM (SELECT * FROM public.premise_places_as_of(p_service_location_id, p_on, 'regulatory')
