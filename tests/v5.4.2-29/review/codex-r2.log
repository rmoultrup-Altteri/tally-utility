777-          AND (
778-              cte.service_types IS NULL
779-              OR array_length(cte.service_types, 1) IS NULL  -- empty array
780-              OR p_service_type IS NULL                      -- caller didn't specify; blanket only
781-              OR p_service_type = ANY(cte.service_types)
782-          )
783-    ) INTO v_has_exemption;
784-
785-    IF v_has_exemption THEN
786-        RETURN false;
787-    END IF;
788-
789-    -- Rule 3: no exemption found, item is taxable, customer is taxable -> charge tax
790-    RETURN true;
791-END;
792-$$;
