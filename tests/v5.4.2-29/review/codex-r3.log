26699:CREATE OR REPLACE FUNCTION public.enforce_premise_place_membership() RETURNS trigger
26700-    LANGUAGE plpgsql
26701-    SET search_path = public, pg_temp
26702-    AS $$
26703-DECLARE
26704-    v_state text;
26705-    v_place public.places%ROWTYPE;
26706-    v_kind public.place_kinds%ROWTYPE;
26707-BEGIN
26708-    IF TG_OP = 'INSERT' THEN
26709-        PERFORM public.assert_place_read_committed('recording a premise place membership');
26710-        BEGIN
26711-            NEW.created_by := NULLIF(current_setting('app.user_id', true), '')::uuid;
26712-        EXCEPTION WHEN OTHERS THEN
26713-            NEW.created_by := NULL;
26714-        END;
26715-        PERFORM public.assert_same_tenant_user(NEW.created_by, NEW.tenant_id, 'created_by');
26716-        -- Share-lock the premise: a change of its state waits for this
26717-        -- membership, then sees it (review r1 B2).
26718-        SELECT upper(btrim(l.state)) INTO v_state FROM public.service_locations l
26719-         WHERE l.id = NEW.service_location_id AND l.tenant_id = NEW.tenant_id
26720-           FOR SHARE;
26721-        IF NOT FOUND THEN
26722-            RAISE EXCEPTION USING MESSAGE = format('premise place membership: service location %s not found (or not visible)', NEW.service_location_id), ERRCODE = 'foreign_key_violation';
26723-        END IF;
26724-        -- Shared place lock: a close of the place waits for this membership's
26725-        -- commit, then sees it.
26726-        PERFORM pg_advisory_xact_lock_shared(public.place_lock_key(NEW.place_id));
26727-        SELECT * INTO v_place FROM public.places p WHERE p.id = NEW.place_id;
26728-        IF NOT FOUND THEN
26729-            RAISE EXCEPTION USING MESSAGE = format('premise place membership: place %s not found (v5.4.2-16)', NEW.place_id), ERRCODE = 'foreign_key_violation';
26730-        END IF;
26731-        SELECT * INTO v_kind FROM public.place_kinds k WHERE k.kind_code = v_place.kind_code;
26732-        NEW.place_kind        := v_kind.kind_code;
26733-        NEW.exclusivity_group := v_kind.exclusivity_group;
26734-        IF NOT coalesce(NEW.axis = ANY (v_kind.membership_axes), false) THEN
26735-            RAISE EXCEPTION USING
26736-                MESSAGE = format('premise place membership rejected: a %s takes %s; not the %s axis (v5.4.2-16)', v_kind.kind_code,
26737-                                 CASE WHEN cardinality(v_kind.membership_axes) = 0 THEN 'no membership (it comes from the premise''s own state)'
26738-                                      ELSE 'membership on ' || array_to_string(v_kind.membership_axes, ' / ') END, NEW.axis),
26739-                ERRCODE = 'check_violation';
26740-        END IF;
26741-        IF v_place.state_code IS DISTINCT FROM v_state THEN
26742-            RAISE EXCEPTION USING
26743-                MESSAGE = format('premise place membership rejected: place %s is in %s; the premise is in %s (v5.4.2-16)', NEW.place_id, v_place.state_code, v_state),
26744-                ERRCODE = 'check_violation';
26745-        END IF;
26746-        IF NOT (daterange(v_place.effective_from, v_place.effective_to, '[)') @> daterange(NEW.valid_from, NEW.valid_to, '[)')) THEN
26747-            RAISE EXCEPTION USING
26748-                MESSAGE = format('premise place membership rejected: place %s is in force %s..%s, not over the whole membership %s..%s (v5.4.2-16)', NEW.place_id, v_place.effective_from, coalesce(v_place.effective_to::text, 'open'), NEW.valid_from, coalesce(NEW.valid_to::text, 'open')),
26749-                ERRCODE = 'check_violation';
26750-        END IF;
26751-        IF NEW.evidence_date > CURRENT_DATE THEN
26752-            RAISE EXCEPTION USING
26753-                MESSAGE = format('premise place membership rejected: its evidence is dated %s, after it is recorded (v5.4.2-16)', NEW.evidence_date),
26754-                ERRCODE = 'check_violation';
26755-        END IF;
26756-        NEW.created_at  := now();
26757-        NEW.closed_at   := NULL;
26758-        NEW.closed_by   := NULL;
26759-        NEW.void_reason := NULL;
26760-        NEW.voided_at   := NULL;
26761-        NEW.voided_by   := NULL;
26762-        RETURN NEW;
26763-    END IF;
26764-    RETURN public.place_citation_close_or_void(OLD, NEW, 'premise place membership', 'valid_to');
26765-END;
26766-$$;
26767-COMMENT ON FUNCTION public.enforce_premise_place_membership() IS
26768-    'v5.4.2-16. BEFORE INSERT OR UPDATE on premise_place_memberships. INSERT: READ COMMITTED only; created_by stamped from the session and of the tenant; the premise visible and the tenant''s, share-locked (a state change waits); the place''s lock taken shared; place_kind and exclusivity_group copied from the place''s kind; the axis one the kind takes (a state takes none); the place of the premise''s normalised state and in force over the whole membership; evidence dated no later than today; stamps (born unclosed, unvoided). UPDATE: a stamped close or void (place_citation_close_or_void). Deletes are refused by no_hard_delete.';
26769-DROP TRIGGER IF EXISTS a_enforce_premise_place_membership ON public.premise_place_memberships;
26770-CREATE TRIGGER a_enforce_premise_place_membership BEFORE INSERT OR UPDATE ON public.premise_place_memberships
26771-    FOR EACH ROW EXECUTE FUNCTION public.enforce_premise_place_membership();
26772-ALTER TABLE public.premise_place_memberships ENABLE ALWAYS TRIGGER a_enforce_premise_place_membership;
