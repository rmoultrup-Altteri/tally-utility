27064-CREATE OR REPLACE FUNCTION public.premise_time_zone_as_of(p_service_location_id uuid, p_on date) RETURNS text
27065-    LANGUAGE plpgsql STABLE
27066-    SET search_path = public, pg_temp
27067-    AS $$
27068-DECLARE
27069-    v_tz text;
27070-    v_kind text;
27071-    v_uniform boolean;
27072-    v_zones text[];
27073-    v_unzoned text;
27074-BEGIN
27075-    -- Both axes place the premise (a county recorded for tax only still
27076-    -- counts — review r1 B3). Every place it is within whose kind can carry a
27077-    -- zone is a candidate, zone or none. The answering level is the most
27078-    -- specific one where some candidate carries a zone: a level where none
27079-    -- does falls through (a city with no zone answers by its county). At that
27080-    -- level every candidate must carry one, and all must agree: two counties
27081-    -- on two axes with different zones (review r2 N1), or one with a zone and
27082-    -- one without (r3: a partial load), are refused, not tie-broken. A more
27083-    -- specific zone outranks a less specific one by design: a city's zone
27084-    -- answers over its county's, and the refusals apply only at the
27085-    -- answering level (a county conflict under a zoned city is not read).
27086-    WITH cand AS (
27087-        SELECT DISTINCT pl.place_id, pl.kind_code, pl.specificity, pl.name, f.value #>> '{}' AS tz
27088-          FROM (SELECT * FROM public.premise_places_as_of(p_service_location_id, p_on, 'regulatory')
27089-                UNION ALL
27090-                SELECT * FROM public.premise_places_as_of(p_service_location_id, p_on, 'tax')) pl
27091-          LEFT JOIN public.place_facts f ON f.place_id = pl.place_id AND f.fact_code = 'time_zone'
27092-                                        AND daterange(f.effective_from, f.effective_to, '[)') @> p_on
27093-         WHERE pl.relation = 'within'
27094-           AND pl.kind_code = ANY ((SELECT k.place_kinds FROM public.place_fact_kinds k WHERE k.fact_code = 'time_zone')::text[])
27095-    )
27096-    SELECT array_agg(DISTINCT c.tz) FILTER (WHERE c.tz IS NOT NULL),
27097-           min(c.kind_code),
27098-           string_agg(c.name, ', ') FILTER (WHERE c.tz IS NULL)
27099-      INTO v_zones, v_kind, v_unzoned
27100-      FROM cand c
27101-     WHERE c.specificity = (SELECT max(z.specificity) FROM cand z WHERE z.tz IS NOT NULL);
27102-    IF v_unzoned IS NOT NULL THEN
27103-        RAISE EXCEPTION USING
27104-            MESSAGE = format('premise %s on %s: %s, as specific as the places that carry its time zone, carries none; the lookup refuses rather than let the other answer (v5.4.2-16)', p_service_location_id, p_on, v_unzoned),
27105-            ERRCODE = 'no_data_found',
27106-            HINT = 'Load that place''s time_zone fact, or correct the membership that is wrong (close or void it).';
27107-    END IF;
27108-    IF cardinality(v_zones) > 1 THEN
27109-        RAISE EXCEPTION USING
27110-            MESSAGE = format('premise %s on %s: the places it is most specifically within disagree on its time zone (%s); the lookup refuses rather than choose (v5.4.2-16)', p_service_location_id, p_on, array_to_string(v_zones, ', ')),
27111-            ERRCODE = 'cardinality_violation',
27112-            HINT = 'Correct the membership that is wrong (close or void it).';
27113-    END IF;
27114-    v_tz := v_zones[1];
27115-    -- Only the state answered: that is an answer only for a state in one
27116-    -- zone. Texas is not (El Paso and Hudspeth are Mountain): a premise with
27117-    -- no county or city recorded is unknown, not Central.
27118-    IF v_kind = 'state' THEN
27119-        SELECT (f.value)::text::boolean INTO v_uniform
27120-          FROM public.premise_places_as_of(p_service_location_id, p_on, 'regulatory') pl
27121-          JOIN public.place_facts f ON f.place_id = pl.place_id AND f.fact_code = 'time_zone_uniform'
27122-                                   AND daterange(f.effective_from, f.effective_to, '[)') @> p_on
27123-         WHERE pl.kind_code = 'state';
27124-        IF v_uniform IS NOT TRUE THEN
27125-            v_tz := NULL;
27126-        END IF;
27127-    END IF;
27128-    IF v_tz IS NULL THEN
27129-        RAISE EXCEPTION USING
27130-            MESSAGE = format('no time zone can be read for premise %s on %s: no place it is within carries one, or only its state does and the state is not in one zone (v5.4.2-16)', p_service_location_id, p_on),
27131-            ERRCODE = 'no_data_found',
27132-            HINT = 'Record the premise''s county (or city) membership; or, for a state in one zone, its time_zone_uniform fact.';
27133-    END IF;
27134-    RETURN v_tz;
27135-END;
27136-$$;
27137-COMMENT ON FUNCTION public.premise_time_zone_as_of(uuid, date) IS
27138-    'v5.4.2-16 (places inventory P8; review r1 B3, r2 N1, r3). The IANA time zone of a premise on a date: the time_zone fact of the most specific places it is within, on either axis, in force, at the most specific level where any carries one — refused if they disagree, or if another place at that level carries none (a city''s zone outranks its county''s; a level with no zone falls through). The state''s own zone answers only where the state''s time_zone_uniform fact is true; otherwise, and when nothing answers, it refuses — never assumes. The replacement for the America/Chicago constant (tu.sql 19184), used when that law area is rebuilt.';
27139-
