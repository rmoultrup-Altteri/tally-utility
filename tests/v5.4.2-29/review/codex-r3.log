27038-    SELECT p.id INTO v_state_place FROM public.places p
27039-     WHERE p.kind_code = 'state' AND p.state_code = v_state AND daterange(p.effective_from, p.effective_to, '[)') @> p_on;
27040-    IF v_state_place IS NULL THEN
27041-        RAISE EXCEPTION USING
27042-            MESSAGE = format('premise_places_as_of: premise %s is not found (or not visible), or its state %s is no state known on %s; its places cannot be read (v5.4.2-16)', p_service_location_id, coalesce(v_state, 'NULL'), p_on),
27043-            ERRCODE = 'no_data_found';
27044-    END IF;
27045-    RETURN QUERY
27046-    SELECT p.id, p.kind_code, p.state_code, p.place_code, p.name, k.specificity, m.relation, m.distance_miles
27047-      FROM public.premise_place_memberships m
