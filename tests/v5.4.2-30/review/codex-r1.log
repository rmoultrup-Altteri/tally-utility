-- 4. Rate item versions: no defaults; the late-penalty base
-- ----------------------------------------------------------------------------
ALTER TABLE public.rate_item_versions ADD COLUMN IF NOT EXISTS in_late_penalty_base boolean NOT NULL;
ALTER TABLE public.rate_item_versions ALTER COLUMN is_taxable_default DROP DEFAULT;
ALTER TABLE public.rate_item_versions ALTER COLUMN is_a_tax DROP DEFAULT;
ALTER TABLE public.rate_item_versions ALTER COLUMN applies_to_customer_types DROP DEFAULT;
ALTER TABLE public.rate_item_versions DROP CONSTRAINT IF EXISTS rate_item_versions_customer_types_check;
ALTER TABLE public.rate_item_versions ADD CONSTRAINT rate_item_versions_customer_types_check
    CHECK ((cardinality(applies_to_customer_types) > 0) AND (array_position(applies_to_customer_types, NULL) IS NULL)
           AND (applies_to_customer_types <@ ARRAY['residential'::text, 'commercial'::text, 'small_commercial'::text, 'large_commercial'::text,
                                                  'industrial'::text, 'government'::text, 'wholesale'::text]));
COMMENT ON COLUMN public.rate_item_versions.is_taxable_default IS
    'Whether the rider''s lines are in the sales-tax base (overridable per schedule, rate_schedule_items.is_taxable_override). Required, no default (v5.4.2-30; Kyle 2026-10-14 answer 5: every charge declares its tax status). A rider with an open regulatory_surcharge_rules row excluded_from_tax_bases can never assert true here (v5.4.2-07). Whether a line is actually taxed also needs the customer taxable for its service type (should_charge_tax).';
COMMENT ON COLUMN public.rate_item_versions.is_a_tax IS
    'Whether the rider is itself a tax. Required, no default (v5.4.2-30). A tax is never in the late-penalty base.';
COMMENT ON COLUMN public.rate_item_versions.in_late_penalty_base IS
    'Whether the rider''s lines are in the base a late penalty is computed on (Kyle 2026-11-05, scenario batch 2 answer 3a: every line priced by the tariff, never taxes or state fees such as the pipeline safety fee; a per-charge setting the utility controls). Required, no default (v5.4.2-30). Never true for a tax, or for a rider excluded from tax bases. The penalty itself is the money stream''s.';
COMMENT ON COLUMN public.rate_item_versions.applies_to_customer_types IS
    'The customer types the rider bills: a non-empty list of the types customers_customer_type_check allows. Required, no default (v5.4.2-30; Kyle 2026-09-02: the old default left out small_commercial and large_commercial and silently skipped them).';

CREATE OR REPLACE FUNCTION public.enforce_late_penalty_base() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path = public, pg_temp
    AS $$
DECLARE
    v_rule public.regulatory_surcharge_rules%ROWTYPE;
BEGIN
    IF NOT NEW.in_late_penalty_base THEN
        RETURN NEW;
    END IF;
    IF NEW.is_a_tax THEN
        RAISE EXCEPTION USING
            MESSAGE = format('rate_item_versions: rate item %s is a tax and cannot be in the late-penalty base (Kyle 2026-11-05, 3a: never on taxes; v5.4.2-30)', NEW.rate_item_id),
            ERRCODE = 'check_violation';
    END IF;
    SELECT r.* INTO v_rule FROM public.regulatory_surcharge_rules r
     WHERE r.rate_item_id = NEW.rate_item_id AND r.recorded_until IS NULL AND r.excluded_from_tax_bases
     ORDER BY r.cycle_start DESC LIMIT 1;
    IF FOUND THEN
        RAISE EXCEPTION USING
            MESSAGE = format('rate_item_versions: rate item %s is a %s surcharge rider excluded from tax bases (regulatory_surcharge_rules %s) and cannot be in the late-penalty base (Kyle 2026-11-05, 3a: never on state fees; v5.4.2-30)',
                             NEW.rate_item_id, v_rule.surcharge_kind, v_rule.id),
            ERRCODE = 'check_violation';
    END IF;
    RETURN NEW;
END;
$$;
COMMENT ON FUNCTION public.enforce_late_penalty_base() IS
    'v5.4.2-30. BEFORE INSERT / UPDATE OF in_late_penalty_base, is_a_tax on rate_item_versions: a version in the late-penalty base is refused when it is a tax, or when its rate item has an open surcharge rule excluded from tax bases. With enforce_surcharge_rule_late_penalty_base() the rule holds in both orders of writing (known limit L2: concurrent writers, as -07).';
DROP TRIGGER IF EXISTS b_enforce_late_penalty_base ON public.rate_item_versions;
CREATE TRIGGER b_enforce_late_penalty_base BEFORE INSERT OR UPDATE OF in_late_penalty_base, is_a_tax ON public.rate_item_versions
    FOR EACH ROW EXECUTE FUNCTION public.enforce_late_penalty_base();

CREATE OR REPLACE FUNCTION public.enforce_surcharge_rule_late_penalty_base() RETURNS trigger
    LANGUAGE plpgsql
    SET search_path = public, pg_temp
-- ============================================================================
-- BATTERY v5.4.2-30 — tax rows keyed to places and the taxability fixes
--   (tests first, 2026-11-05; interface: application/rates-build-2026-11-05/
--    tax-design.md section 2.8)
-- Run: psql -U tally -d <db-with-patch> -v ON_ERROR_STOP=1 -f battery-30.sql
-- One transaction, rolled back. Fixtures as the owner; the guards the
-- application meets are exercised as tally_app. refuses_at() requires the
-- named SQLSTATE AND a fragment of the named guard's message (or the
-- constraint's name), so a test cannot pass on another guard that shares the
-- SQLSTATE. ok() treats NULL as a fail. The first FAIL stops the run.
--
--   L  the utility's tax levies (Kyle 2026-10-14 answers 1, 2; Ryan's rule
--      that a value the utility answers for is its own row): on the
--      rule-terms template, keyed to a place and a tax kind; only a kind of
--      place that levies the tax; the place in the row's state and in force
--      over its dates; percent, four decimals; tax on tax named, never its
--      own kind, empty by default; a source and a citation; one row per key
--      and day; never edited, closed once; the utility's own rows only.
--   Q  the levy read as of a date and a recorded instant; NULL raises.
--   G  the reference compare: a levy that differs from the published rate
--      is reported, one that agrees is not.
--   F  the published sales-tax rate is percent (AC-45).
--   T  every rate item version states its taxability, whether it is a tax,
--      whether it is in the late-penalty base (Kyle 2026-11-05, 3a) and its
--      customer types (the size-tier defect, Kyle 2026-09-02): no defaults.
--   P  the late-penalty base never holds a tax or a rider excluded from tax
--      bases (the pipeline safety fee), in both orders of writing.
--   E  exemptions name their services; a NULL service type raises.
--   M  a premise's places as known at a past instant.
--   A  a state agency's basis is required and logged (Kyle 2026-11-05, 20).
--
-- Transaction time: inside one transaction every stamp is now(). A row
-- "recorded earlier" is planted by moving its stamp back with the table's
-- guard disabled (owner only, rolled back); every tested write runs with
-- every guard on.
-- ============================================================================
BEGIN;

CREATE FUNCTION pg_temp.refuses_at(p_label text, p_sql text, p_state text, p_guard text) RETURNS void
LANGUAGE plpgsql AS $$
DECLARE v_con text;
BEGIN
  BEGIN
    EXECUTE p_sql;
  EXCEPTION WHEN OTHERS THEN
    GET STACKED DIAGNOSTICS v_con = CONSTRAINT_NAME;
    IF SQLSTATE = p_state AND (v_con = p_guard OR strpos(SQLERRM, p_guard) > 0) THEN
      RAISE NOTICE 'PASS %: refused by % (%)', p_label, p_guard, left(SQLERRM, 140);
      RETURN;
    END IF;
    RAISE EXCEPTION 'FAIL %: refused with % [%] (%), expected % by %', p_label, SQLSTATE, v_con, SQLERRM, p_state, p_guard;
  END;
  RAISE EXCEPTION 'FAIL %: accepted', p_label;
END $$;
-- ok_q(): ok() over a query's text, so an error inside the read is a FAIL of
-- this label, not an unlabelled stop (mutation N14 of the as-of read).
CREATE FUNCTION pg_temp.ok_q(p_label text, p_sql text) RETURNS void
LANGUAGE plpgsql AS $$
DECLARE v boolean;
BEGIN
  BEGIN
    EXECUTE p_sql INTO v;
  EXCEPTION WHEN OTHERS THEN
    RAISE EXCEPTION 'FAIL %: the read raised % (%)', p_label, SQLSTATE, SQLERRM;
  END;
  IF v IS DISTINCT FROM true THEN RAISE EXCEPTION 'FAIL %', p_label; END IF;
  RAISE NOTICE 'PASS %', p_label;
END $$;
CREATE FUNCTION pg_temp.ok(p_label text, p_cond boolean) RETURNS void
LANGUAGE plpgsql AS $$
BEGIN
  IF p_cond IS DISTINCT FROM true THEN RAISE EXCEPTION 'FAIL %', p_label; END IF;
  RAISE NOTICE 'PASS %', p_label;
END $$;
CREATE FUNCTION pg_temp.admits(p_label text, p_sql text) RETURNS void
LANGUAGE plpgsql AS $$
BEGIN
  EXECUTE p_sql;
  RAISE NOTICE 'PASS %', p_label;
EXCEPTION WHEN OTHERS THEN
  RAISE EXCEPTION 'FAIL %: refused with % (%)', p_label, SQLSTATE, SQLERRM;
END $$;
GRANT EXECUTE ON FUNCTION pg_temp.refuses_at(text, text, text, text), pg_temp.ok(text, boolean), pg_temp.ok_q(text, text), pg_temp.admits(text, text) TO tally_app;

-- A levy row as the tests write it: id or NULL, tenant, state, the place by its kind and code, the tax kind, dates, terms (JSON text).
CREATE FUNCTION pg_temp.levy_sql(p_id uuid, p_tenant uuid, p_state text, p_pkind text, p_pcode text, p_kind text, p_from date, p_to date, p_terms text) RETURNS text
LANGUAGE sql AS $$
  SELECT format($f$INSERT INTO public.tax_levies (id, tenant_id, state_code, service_type, system_kind, place_kind, place_code, tax_kind, effective_from, effective_to,
                    tariff_reference, terms_kind, terms_version, terms_source)
                  VALUES (%L, %L, %L, 'gas', 'distribution', %L, %L, %L, %L, %L, 'City tariff 30', 'tax_levy', 1, %L)$f$,
                coalesce(p_id, public.uuid_generate_v4()), p_tenant, p_state, p_pkind, p_pcode, p_kind, p_from, p_to, p_terms)
$$;
GRANT EXECUTE ON FUNCTION pg_temp.levy_sql(uuid, uuid, text, text, text, text, date, date, text) TO tally_app;

