                  VALUES ('00000000-0000-4000-8000-0000000030a1', %L, 'Item', 'gas', 'fixed_monthly', 'regulated', DATE '2026-01-01', 'initial'%s)$f$,
                p_cols, p_item, p_vals)
$$;
