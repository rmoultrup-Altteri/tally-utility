   285	CREATE OR REPLACE FUNCTION public.tax_levy_insert_check(p_row jsonb) RETURNS void
   286	    LANGUAGE plpgsql VOLATILE
   287	    SET search_path = public, pg_temp
   288	    AS $$
   289	DECLARE
   290	    v_kinds  text[];
   291	    v_cover  datemultirange;
   292	    v_range  daterange := daterange((p_row ->> 'effective_from')::date, (p_row ->> 'effective_to')::date, '[)');
   293	    v_rate   numeric := (p_row -> 'terms' ->> 'rate_percent')::numeric;
   294	    v_on     text;
   295	    v_place  uuid;
   296	    v_locked uuid[] := ARRAY[]::uuid[];
   297	    v_now    uuid[];
   298	BEGIN
   299	    IF NOT public.is_platform_admin() AND (p_row ->> 'tenant_id')::uuid IS DISTINCT FROM public.get_user_tenant_id()
   300	       AND NOT coalesce((SELECT r.rolsuper OR r.rolbypassrls FROM pg_roles r WHERE r.rolname = current_user), false) THEN
   301	        RAISE EXCEPTION USING
   302	            MESSAGE = 'new row violates row-level security policy for table "tax_levies": a utility writes its own levies only (v5.4.2-30)',
   303	            ERRCODE = 'insufficient_privilege';
   304	    END IF;
   305	    SELECT t.place_kinds INTO v_kinds FROM public.tax_kinds t WHERE t.tax_kind = p_row ->> 'tax_kind';
   306	    IF NOT coalesce(p_row ->> 'place_kind' = ANY (v_kinds), false) THEN
   307	        RAISE EXCEPTION USING
   308	            MESSAGE = format('tax levy: a %s does not levy %s (tax_kinds: %s; v5.4.2-30)', p_row ->> 'place_kind', p_row ->> 'tax_kind', coalesce(array_to_string(v_kinds, ', '), 'no such tax kind')),
   309	            ERRCODE = 'check_violation';
   310	    END IF;
   311	    -- The place, by kind and code in the row's state: its rows together
   312	    -- cover the levy's dates (a successor row of the same place continues it).
   313	    -- Each row's lock is taken shared first, so a close of it waits for this
   314	    -- levy's commit and then sees it (section 2b); the rows are then re-read
   315	    -- under READ COMMITTED (a close committed meanwhile is seen).
   316	    PERFORM public.assert_place_read_committed('recording a tax levy');
   317	    FOR v_place IN SELECT p.id FROM public.places p
   318	                    WHERE p.kind_code = p_row ->> 'place_kind' AND p.state_code = p_row ->> 'state_code' AND p.place_code = p_row ->> 'place_code'
   319	                    ORDER BY p.id LOOP
   320	        PERFORM pg_advisory_xact_lock_shared(public.place_lock_key(v_place));
   321	        v_locked := v_locked || v_place;
   322	    END LOOP;
   323	    -- r3 (-16's rule, race R19 there): a row of the code committed while this
   324	    -- waited was never locked, so it is not trusted; the writer retries.
   325	    SELECT coalesce(array_agg(p.id ORDER BY p.id), ARRAY[]::uuid[]) INTO v_now FROM public.places p
   326	     WHERE p.kind_code = p_row ->> 'place_kind' AND p.state_code = p_row ->> 'state_code' AND p.place_code = p_row ->> 'place_code';
   327	    IF v_now <> v_locked THEN
   328	        RAISE EXCEPTION USING
   329	            MESSAGE = format('tax levy: the rows of %s %s in %s changed while this waited; retry (v5.4.2-30)', p_row ->> 'place_kind', p_row ->> 'place_code', p_row ->> 'state_code'),
   330	            ERRCODE = 'serialization_failure';
   331	    END IF;
   332	    SELECT range_agg(daterange(p.effective_from, p.effective_to, '[)')) INTO v_cover
   333	      FROM public.places p
   334	     WHERE p.kind_code = p_row ->> 'place_kind' AND p.state_code = p_row ->> 'state_code' AND p.place_code = p_row ->> 'place_code';
   335	    IF v_cover IS NULL OR NOT v_cover @> v_range THEN
   336	        RAISE EXCEPTION USING
   337	            MESSAGE = format('tax levy: no %s %s in %s is in force over the whole of %s (its rows: %s; v5.4.2-30)',
   338	                             p_row ->> 'place_kind', p_row ->> 'place_code', p_row ->> 'state_code', v_range, coalesce(v_cover::text, 'none')),
   339	            ERRCODE = 'check_violation';
   340	    END IF;
   341	    IF v_rate IS DISTINCT FROM round(v_rate, 4) THEN
   342	        RAISE EXCEPTION USING
   343	            MESSAGE = format('tax levy: a rate carries at most four decimals, in percent (K-06, AC-45); got %s (v5.4.2-30)', v_rate),
   344	            ERRCODE = 'check_violation';
   345	    END IF;
   346	    FOR v_on IN SELECT jsonb_array_elements_text(p_row -> 'terms' -> 'computed_on') LOOP
   347	        IF v_on = p_row ->> 'tax_kind' THEN
   348	            RAISE EXCEPTION USING
   349	                MESSAGE = format('tax levy: computed_on names its own kind (%s): a levy is never charged on itself (v5.4.2-30)', v_on),
   350	                ERRCODE = 'check_violation';
   351	        END IF;
   352	        IF NOT EXISTS (SELECT 1 FROM public.tax_kinds t WHERE t.tax_kind = v_on) THEN
   353	            RAISE EXCEPTION USING
   354	                MESSAGE = format('tax levy: computed_on names %s, which is not a tax kind (v5.4.2-30)', v_on),
   355	                ERRCODE = 'check_violation';
   356	        END IF;
   357	    END LOOP;
   358	END;
   359	$$;
   360	COMMENT ON FUNCTION public.tax_levy_insert_check(jsonb) IS
   361	    'v5.4.2-30. The area predicate of tax_levies (rule_tables.insert_check), over the new row with its document: the writer is the row''s own utility; the place kind levies the tax (tax_kinds.place_kinds); a place of that kind and code in the row''s state is in force over the whole of the row''s dates (READ COMMITTED; each of the code''s rows share-locked first, so a close waits and then sees the levy); the rate has at most four decimals; computed_on names known tax kinds, never the levy''s own. Raises.';
