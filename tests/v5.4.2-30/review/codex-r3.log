   431	CREATE OR REPLACE FUNCTION public.tax_levy_as_of(p_tenant_id uuid, p_state_code text, p_place_kind text, p_place_code text, p_tax_kind text,
   432	                                                 p_service_type text, p_system_kind text, p_on date, p_recorded_at timestamp with time zone)
   433	    RETURNS SETOF public.tax_levies
   434	    LANGUAGE plpgsql STABLE
   435	    SET search_path = public, pg_temp
   436	    AS $$
   437	DECLARE
   438	    v_n integer;
   439	BEGIN
   440	    IF p_tenant_id IS NULL OR p_state_code IS NULL OR p_place_kind IS NULL OR p_place_code IS NULL OR p_tax_kind IS NULL
   441	       OR p_service_type IS NULL OR p_system_kind IS NULL OR p_on IS NULL OR p_recorded_at IS NULL THEN
   442	        RAISE EXCEPTION USING
   443	            MESSAGE = 'tax_levy_as_of: every argument is required — never default to today or to now() (v5.4.2-30)',
   444	            ERRCODE = 'null_value_not_allowed';
   445	    END IF;
   446	    RETURN QUERY
   447	    SELECT t.* FROM public.tax_levies t
   448	     WHERE t.tenant_id = p_tenant_id AND t.state_code = p_state_code AND t.place_kind = p_place_kind AND t.place_code = p_place_code
   449	       AND t.tax_kind = p_tax_kind AND t.service_type = p_service_type AND t.system_kind = p_system_kind
   450	       AND t.created_at <= p_recorded_at
   451	       AND daterange(t.effective_from, public.end_as_known(t.effective_to, t.closed_at, p_recorded_at), '[)') @> p_on;
   452	    GET DIAGNOSTICS v_n = ROW_COUNT;
   453	    IF v_n > 1 THEN
   454	        RAISE EXCEPTION USING
   455	            MESSAGE = format('tax_levy_as_of: %s rows of %s %s %s in force on %s as known at %s (v5.4.2-30)', v_n, p_place_kind, p_place_code, p_tax_kind, p_on, p_recorded_at),
   456	            ERRCODE = 'cardinality_violation';
   457	    END IF;
   458	END;
   459	$$;
   460	COMMENT ON FUNCTION public.tax_levy_as_of(uuid, text, text, text, text, text, text, date, timestamp with time zone) IS
   461	    'v5.4.2-30 (CI-001, CI-004). The utility''s levy of a tax by a place (kind and code, as premise_places_as_of returns it) for a service and system, in force on p_on as known at p_recorded_at: recorded by then, and its end only if its close was recorded by then. No row: none. Every argument required (NULL raises); invoker rights, RLS applies.';
   462	
   463	CREATE OR REPLACE FUNCTION public.tax_levy_reference_gaps(p_tenant_id uuid, p_on date)
   464	    RETURNS TABLE (levy_id uuid, place_kind text, place_code text, levy_rate_percent numeric, reference_rate_percent numeric, reference_source text)
   465	    LANGUAGE plpgsql STABLE
   466	    SET search_path = public, pg_temp
   467	    AS $$
   468	BEGIN
   469	    IF p_tenant_id IS NULL OR p_on IS NULL THEN
   470	        RAISE EXCEPTION USING
   471	            MESSAGE = 'tax_levy_reference_gaps: the utility and the date are required (v5.4.2-30)',
   472	            ERRCODE = 'null_value_not_allowed';
   473	    END IF;
   474	    RETURN QUERY
   475	    -- A levy whose rate differs from the published one.
   476	    SELECT t.id, t.place_kind, t.place_code, (t.terms ->> 'rate_percent')::numeric, (f.value #>> '{}')::numeric, f.source_note
   477	      FROM public.tax_levies t
   478	      JOIN public.places p ON p.kind_code = t.place_kind AND p.state_code = t.state_code AND p.place_code = t.place_code
   479	                          AND daterange(p.effective_from, p.effective_to, '[)') @> p_on
   480	      JOIN public.place_facts f ON f.place_id = p.id AND f.fact_code = 'sales_tax_rate'
   481	                               AND daterange(f.effective_from, f.effective_to, '[)') @> p_on
   482	     WHERE t.tenant_id = p_tenant_id AND t.tax_kind = 'sales_tax'
   483	       AND daterange(t.effective_from, t.effective_to, '[)') @> p_on
   484	       AND (t.terms ->> 'rate_percent')::numeric IS DISTINCT FROM (f.value #>> '{}')::numeric
   485	    UNION ALL
   486	    -- r2 (review r1, Fable S6): a place the utility's premises are in (an open
   487	    -- tax-axis membership on p_on, or the premise's state), publishing a rate
   488	    -- on p_on, with no sales-tax levy of the utility in force: a published tax
   489	    -- nobody approved (known limit L1).
   490	    SELECT NULL::uuid, p.kind_code, p.place_code, NULL::numeric, (f.value #>> '{}')::numeric, f.source_note
   491	      FROM public.places p
   492	      JOIN public.place_facts f ON f.place_id = p.id AND f.fact_code = 'sales_tax_rate'
   493	                               AND daterange(f.effective_from, f.effective_to, '[)') @> p_on
   494	     WHERE daterange(p.effective_from, p.effective_to, '[)') @> p_on
   495	       AND (EXISTS (SELECT 1 FROM public.premise_place_memberships m
   496	                     WHERE m.place_id = p.id AND m.tenant_id = p_tenant_id AND m.axis = 'tax' AND m.voided_at IS NULL
   497	                       AND daterange(m.valid_from, m.valid_to, '[)') @> p_on)
   498	            OR (p.kind_code = 'state'
   499	                AND EXISTS (SELECT 1 FROM public.service_locations l
   500	                             WHERE l.tenant_id = p_tenant_id AND upper(btrim(l.state)) = p.state_code)))
   501	       AND NOT EXISTS (SELECT 1 FROM public.tax_levies t
   502	                        WHERE t.tenant_id = p_tenant_id AND t.tax_kind = 'sales_tax' AND t.state_code = p.state_code
   503	                          AND t.place_kind = p.kind_code AND t.place_code = p.place_code
   504	                          AND daterange(t.effective_from, t.effective_to, '[)') @> p_on)
   505	     ORDER BY 2, 3;
   506	END;
   507	$$;
   508	COMMENT ON FUNCTION public.tax_levy_reference_gaps(uuid, date) IS
   509	    'v5.4.2-30 (Ryan 2026-09-30: the platform keeps the published value as a reference and reports a disagreement). On p_on: each sales-tax levy of the utility whose place carries a published sales_tax_rate that differs (both rates and the published value''s source); and (r2) each place the utility''s premises are in (an open tax-axis membership, or the premise''s state) that publishes a rate while the utility has no levy of it (levy_id and levy_rate_percent NULL). A report, never a refusal: the utility''s row bills. The second part reads memberships and premises as they stand now, counts every premise of the utility whatever its status, and does not look at service type: a place listed for an inactive premise is a false alarm, never a missed one. Both arguments required.';
   510	REVOKE ALL ON FUNCTION public.tax_levy_as_of(uuid, text, text, text, text, text, text, date, timestamp with time zone),
   511	                       public.tax_levy_reference_gaps(uuid, date), public.end_as_known(date, timestamp with time zone, timestamp with time zone) FROM PUBLIC;
   512	GRANT EXECUTE ON FUNCTION public.tax_levy_as_of(uuid, text, text, text, text, text, text, date, timestamp with time zone),
   513	                          public.tax_levy_reference_gaps(uuid, date), public.end_as_known(date, timestamp with time zone, timestamp with time zone) TO tally_app, tally_core;
