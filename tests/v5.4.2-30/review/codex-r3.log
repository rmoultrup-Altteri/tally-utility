   747	    -- began was written by a transaction that began later and committed
   748	    -- first (both hold the premise's row lock). Recorded after it, this row
   749	    -- would sort below it and the history would end on the wrong state, so
   750	    -- this writer retries.
   751	    IF TG_OP = 'UPDATE' AND EXISTS (SELECT 1 FROM public.service_location_state_history h
   752	                                     WHERE h.service_location_id = NEW.id AND h.recorded_at > now()) THEN
   753	        RAISE EXCEPTION USING
   754	            MESSAGE = format('service location %s: its state was recorded by a transaction that began after this one; retry (v5.4.2-30)', NEW.id),
   755	            ERRCODE = 'serialization_failure';
   756	    END IF;
