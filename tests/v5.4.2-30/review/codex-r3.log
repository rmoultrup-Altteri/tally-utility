   536	CREATE OR REPLACE FUNCTION public.enforce_late_penalty_base() RETURNS trigger
   537	    LANGUAGE plpgsql
   538	    SET search_path = public, pg_temp
   539	    AS $$
   540	DECLARE
   541	    v_rule public.regulatory_surcharge_rules%ROWTYPE;
   542	BEGIN
   543	    IF NOT NEW.in_late_penalty_base THEN
   544	        RETURN NEW;
   545	    END IF;
   546	    IF NEW.is_a_tax THEN
   547	        RAISE EXCEPTION USING
   548	            MESSAGE = format('rate_item_versions: rate item %s is a tax and cannot be in the late-penalty base (Kyle 2026-11-05, 3a: never on taxes; v5.4.2-30)', NEW.rate_item_id),
   549	            ERRCODE = 'check_violation';
   550	    END IF;
   551	    SELECT r.* INTO v_rule FROM public.regulatory_surcharge_rules r
   552	     WHERE r.rate_item_id = NEW.rate_item_id AND r.recorded_until IS NULL AND r.excluded_from_tax_bases
   553	     ORDER BY r.cycle_start DESC LIMIT 1;
   554	    IF FOUND THEN
   555	        RAISE EXCEPTION USING
   556	            MESSAGE = format('rate_item_versions: rate item %s is a %s surcharge rider excluded from tax bases (regulatory_surcharge_rules %s) and cannot be in the late-penalty base (Kyle 2026-11-05, 3a: never on state fees; v5.4.2-30)',
   557	                             NEW.rate_item_id, v_rule.surcharge_kind, v_rule.id),
   558	            ERRCODE = 'check_violation';
   559	    END IF;
   560	    RETURN NEW;
   561	END;
   562	$$;
   563	COMMENT ON FUNCTION public.enforce_late_penalty_base() IS
   564	    'v5.4.2-30. BEFORE INSERT / UPDATE OF in_late_penalty_base, is_a_tax on rate_item_versions: a version in the late-penalty base is refused when it is a tax, or when its rate item has an open surcharge rule excluded from tax bases. With enforce_surcharge_rule_late_penalty_base() the rule holds in both orders of writing (known limit L2: concurrent writers, as -07).';
   565	DROP TRIGGER IF EXISTS b_enforce_late_penalty_base ON public.rate_item_versions;
