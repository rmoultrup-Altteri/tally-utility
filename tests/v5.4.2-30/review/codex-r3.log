   650	-- ----------------------------------------------------------------------------
   651	-- 6. The published sales-tax rate is percent
   652	-- ----------------------------------------------------------------------------
   653	-- A reviewed platform repair of a vocabulary row (the guard's own hint: "a row
   654	-- wrong from its first day is a reviewed platform repair"): the kind was
   655	-- seeded as a fraction, against AC-45, and no fact of it exists, so nothing
   656	-- changes meaning. The guard is lifted for this one statement, in this
   657	-- transaction, and set back to ALWAYS before anything else runs. Refused if
   658	-- any sales_tax_rate fact exists (its value would change meaning).
   659	DO $repair30$
   660	BEGIN
   661	    -- r2 (review r1: Opus S3, Fable S3, Codex S1): only while the repair is
   662	    -- still to be made; once the kind is percent, its facts are percent.
   663	    IF EXISTS (SELECT 1 FROM public.place_fact_kinds WHERE fact_code = 'sales_tax_rate' AND value_max IS DISTINCT FROM 100)
   664	       AND EXISTS (SELECT 1 FROM public.place_facts WHERE fact_code = 'sales_tax_rate') THEN
   665	        RAISE EXCEPTION 'v5.4.2-30 precondition: sales_tax_rate facts exist; their values are fractions and the kind cannot move to percent in place';
   666	    END IF;
   667	END
   668	$repair30$;
   669	ALTER TABLE public.place_fact_kinds DISABLE TRIGGER a_enforce_place_vocabulary_immutable;
   670	UPDATE public.place_fact_kinds
   671	   SET value_max = 100,
   672	       description = 'The place''s published sales-tax rate, in percent (8.25 = 8.25%), 0 up to but not including 100, stored as the tax authority publishes it and dated as it publishes it. A reference value: the utility''s own levy (tax_levies, four decimals at most) bills.',
   673	       source_note = 'Texas Tax 321.102 (quarter-start effective dates), Comptroller rate file (inventory P7; review r1 B5); in percent since v5.4.2-30 (AC-45)'
   674	 WHERE fact_code = 'sales_tax_rate' AND (value_max IS DISTINCT FROM 100 OR description !~ 'in percent');
   675	ALTER TABLE public.place_fact_kinds ENABLE ALWAYS TRIGGER a_enforce_place_vocabulary_immutable;
