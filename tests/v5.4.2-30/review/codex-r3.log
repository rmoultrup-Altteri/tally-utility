   822	                 JOIN public.places p ON p.id = m.place_id
   823	                WHERE m.service_location_id = p_service_location_id AND m.axis = p_axis
   824	                  AND m.relation = 'within' AND m.exclusivity_group IS NOT NULL
   825	                  AND m.created_at <= p_recorded_at AND (m.voided_at IS NULL OR m.voided_at > p_recorded_at)
   826	                  AND daterange(m.valid_from, public.end_as_known(m.valid_to, m.closed_at, p_recorded_at), '[)') @> p_on
   827	                  AND p.created_at <= p_recorded_at
   828	                  AND daterange(p.effective_from, public.end_as_known(p.effective_to, p.closed_at, p_recorded_at), '[)') @> p_on
