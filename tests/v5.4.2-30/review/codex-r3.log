   738	CREATE OR REPLACE FUNCTION public.record_service_location_state() RETURNS trigger
   739	    LANGUAGE plpgsql
   740	    SET search_path = public, pg_temp
   741	    AS $$
   742	BEGIN
   743	    IF TG_OP = 'UPDATE' AND upper(btrim(NEW.state)) IS NOT DISTINCT FROM upper(btrim(OLD.state)) THEN
   744	        RETURN NULL;
   745	    END IF;
