   609	CREATE OR REPLACE FUNCTION public.should_charge_tax(p_customer_id uuid, p_item_is_taxable boolean, p_service_type text, p_valid_at date, p_recorded_at timestamp with time zone) RETURNS boolean
   610	    LANGUAGE plpgsql STABLE
   611	    SET search_path = public, pg_temp
   612	    AS $$
   613	DECLARE
   614	    v_has_exemption boolean;
   615	BEGIN
   616	    IF p_valid_at IS NULL OR p_recorded_at IS NULL THEN
   617	        RAISE EXCEPTION 'should_charge_tax: p_valid_at and p_recorded_at are both required — never default to now() (CI-001 / CI-003 / CI-006)';
   618	    END IF;
   619	
   620	    -- v5.4.2-30 (Kyle 2026-10-14 answer 5: customer taxability is per service
   621	    -- type): a line with no service type matches no exemption; it is refused,
   622	    -- not read as matching every exemption.
   623	    IF p_service_type IS NULL THEN
   624	        RAISE EXCEPTION USING
   625	            MESSAGE = 'should_charge_tax: a service type is required: a line with none matches no exemption (v5.4.2-30)',
   626	            ERRCODE = 'null_value_not_allowed';
   627	    END IF;
   628	
   629	    -- Rule 1: item-level non-taxable wins
   630	    IF p_item_is_taxable IS NULL OR p_item_is_taxable = false THEN
   631	        RETURN false;
   632	    END IF;
   633	
   634	    -- Rule 2: a customer exemption asserted as of p_recorded_at, covering p_valid_at and the service type
   635	    SELECT EXISTS (
   636	        SELECT 1
   637	        FROM public.customer_tax_exemption_as_of(p_customer_id, p_valid_at, p_recorded_at) cte
   638	        WHERE p_service_type = ANY (cte.service_types)   -- v5.4.2-30: every exemption names its services
   639	    ) INTO v_has_exemption;
   640	
   641	    IF v_has_exemption THEN
   642	        RETURN false;
   643	    END IF;
   644	
   645	    -- Rule 3: taxable item, no exemption -> charge tax
   646	    RETURN true;
   647	END;
   648	$$;
