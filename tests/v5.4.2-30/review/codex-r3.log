   374	-- ----------------------------------------------------------------------------
   375	-- 2b. A place is never closed from under a levy (r2; review r1: Codex B1,
   376	--     Opus S2, Fable S1)
   377	-- ----------------------------------------------------------------------------
   378	-- -16's enforce_place() refuses a close while a citing row runs past it. A
   379	-- levy names its place by code, and a succession is a close then a successor
   380	-- row (the rows of one code never overlap), so the levy's check runs at
   381	-- commit: by then the successor is there, or the close is refused. The closer
   382	-- sees every tenant (enforce_place requires superuser or BYPASSRLS) and holds
   383	-- the place's exclusive lock until commit; a levy insert takes it shared
   384	-- (tax_levy_insert_check), so the two serialise.
   385	CREATE OR REPLACE FUNCTION public.check_place_levy_coverage() RETURNS trigger
   386	    LANGUAGE plpgsql
   387	    SET search_path = public, pg_temp
   388	    AS $$
   389	DECLARE
   390	    v_levy uuid;
   391	    v_sees_all boolean;
   392	BEGIN
   393	    -- r3 (review r2, Fable S1): the levies are tenant rows; the check runs
   394	    -- as whoever holds the session at commit, so it requires a role that
   395	    -- sees them all, as the close itself does (enforce_place).
   396	    SELECT r.rolsuper OR r.rolbypassrls INTO v_sees_all FROM pg_catalog.pg_roles r WHERE r.rolname = current_user;
   397	    IF v_sees_all IS NOT TRUE THEN
   398	        RAISE EXCEPTION USING
   399	            MESSAGE = format('place %s: its close is checked against every tenant''s levies, which needs a role that sees them all (superuser or BYPASSRLS); %s does not (v5.4.2-30)', OLD.id, current_user),
   400	            ERRCODE = 'insufficient_privilege';
   401	    END IF;
   402	    SELECT t.id INTO v_levy FROM public.tax_levies t
   403	     WHERE t.place_kind = OLD.kind_code AND t.state_code = OLD.state_code AND t.place_code = OLD.place_code
   404	       AND NOT coalesce((SELECT range_agg(daterange(p.effective_from, p.effective_to, '[)')) FROM public.places p
   405	                          WHERE p.kind_code = t.place_kind AND p.state_code = t.state_code AND p.place_code = t.place_code)
   406	                        @> daterange(t.effective_from, t.effective_to, '[)'), false)
   407	     ORDER BY t.id LIMIT 1;
   408	    IF v_levy IS NOT NULL THEN
   409	        RAISE EXCEPTION USING
   410	            MESSAGE = format('place %s: closed at %s, a tax levy %s of %s %s runs past what the place''s rows cover; add the successor row in the same transaction, or have the utility close its levy first (v5.4.2-30)',
   411	                             OLD.id, NEW.effective_to, v_levy, OLD.kind_code, OLD.place_code),
   412	            ERRCODE = 'restrict_violation';
   413	    END IF;
   414	    RETURN NULL;
   415	END;
   416	$$;
   417	COMMENT ON FUNCTION public.check_place_levy_coverage() IS
   418	    'v5.4.2-30 r2. Deferred (at commit) AFTER UPDATE OF effective_to on places, every role: after a place row''s close, every tax levy of its kind, state and code must still be covered by that code''s rows. A succession (the close and the successor row in one transaction) passes; a dissolution waits for the utility''s close of its levy.';
   419	REVOKE ALL ON FUNCTION public.check_place_levy_coverage() FROM PUBLIC;
   420	DROP TRIGGER IF EXISTS z_check_place_levy_coverage ON public.places;

