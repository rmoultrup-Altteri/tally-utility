# two(): A's SQL holds 3s; B's SQL starts 1s later; B is sampled while A holds.
two() {  # $1 A's SQL, $2 B's SQL
"${PSQL[@]}" >"$A_OUT" 2>&1 <<SQL &
BEGIN;
$1
SELECT pg_sleep(3);
COMMIT;
SQL
