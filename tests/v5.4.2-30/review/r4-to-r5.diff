+  elif [ "$state" = 21000 ]; then echo "FAIL $1 [read:21000]: $3"; fail=1
+  else echo "BROKEN $1: the read failed: $3"; fail=1; fi
+else echo "BROKEN $1: the read failed (exit $2): $3"; fail=1; fi
